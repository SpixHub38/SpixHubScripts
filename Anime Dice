local function report(key, message, errorState)
	if not app.alive then return end
	local row = app.rows[key]
	if row then row.status.Text, row.status.TextColor3 = message, errorState and colors.red or colors.muted end
end
local function toggle(key, enabled, managed)
	if not managed and app.flags.Kaitun and app.kaitun.saved and app.kaitun.saved[key] ~= nil then
		-- A manual control takes over cleanly; restore the other controls first.
		toggle("Kaitun", false, true)
	end
	app.flags[key] = enabled
	local row = app.rows[key]
	if row then
		row.button.Text = enabled and "ON" or "OFF"
		row.button.BackgroundColor3 = enabled and colors.primary or colors.surface
		row.status.Text = enabled and "Starting..." or "Paused"
	end
	app.retry[key] = 0
	if app.failures then app.failures[key] = 0 end
	if key == "Traits" or key == "Grades" then
		app.budget[key] = 0
		app.rerollEpoch = app.rerollEpoch or {}
		app.rerollEpoch[key] = (app.rerollEpoch[key] or 0) + 1
	end
	if app.onToggle then app.onToggle(key, enabled) end
end
