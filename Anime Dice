local function reroll(key)
	if not app.flags[key] or read("PendingTrade") or app.travel.pausing or inventoryRequestPending() then return end
	if not weatherAllows(key) then
		report(key, "Waiting for " .. (key == "Traits" and "Trait Luck" or "Grade Luck") .. " weather."); return
	end
	local inv = assert(inventory(), "Waiting for inventory.")
	local managed = app.flags.Kaitun == true
	local plans = autoRerollPlans(inv)
	if managed then app.kaitun.rerolls = plans end
	if app.budget[key] >= math.floor(app.options.rerollLimit) then
		report(key, "Reroll limit reached. Turn off/on to start again."); return
	end
	local token = key == "Traits" and "Trait Reroll" or "Gems"
	local before = tokenAmount(inv, token)
	if before - 1 < app.options.tokenReserve then report(key, "Waiting for " .. token .. ". Reserve: " .. app.options.tokenReserve); return end
	local plan = plans[key]
	if not plan then report(key, "Your best units are ready, or no rollable upgrade is available."); return end
	local id, field = plan.id, key == "Traits" and "trait" or "grade"
