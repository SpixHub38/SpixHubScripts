app.cleanupTower = function()
	if app.tower.cleanupRunning then return end
	app.tower.cleanupRunning = true
	task.spawn(function()
		pcall(function()
			local limit = os.clock() + 10
			while (app.requests["Towers/PlayTower"] or app.requests["Towers/CompleteTowerFloor"]) and os.clock() < limit do task.wait(0.1) end
			-- A late response calls this function again after removing the pending request.
			if app.requests["Towers/PlayTower"] or app.requests["Towers/CompleteTowerFloor"] then return end
			if app.tower.owned then
				remote("Towers", "RF", "CancelTower"):InvokeServer()
				local deadline = math.max(os.clock(), app.tower.nextAt)
				while os.clock() < deadline do task.wait(math.min(0.5, deadline - os.clock())) end
				local sequence = remote("Towers", "RF", "CompleteTowerFloor"):InvokeServer()
				if type(sequence) == "table" then
					for _, action in ipairs(sequence) do if action.action == "ended" then app.tower.owned = false end end
				end
			end
			if not app.tower.owned and app.nativeTower ~= nil then
				fire("Towers", "SetAutoTower", app.nativeTower ~= "" and app.nativeTower or false)
				app.nativeTower = nil
			end
		end)
		app.tower.cleanupRunning = false
	end)
end
local function cleanup()
	if not app.alive then return end
	app.alive = false
	app.cleanupTower()
	if app.nativeRoll ~= nil then pcall(fire, "RollService", "SetAutoRoll", app.nativeRoll) end
	if app.nativeSell ~= nil then pcall(fire, "SellService", "UpdateAutoSell", app.nativeSell) end
	local unlock = {}
	for id in pairs(app.ownedLocks) do if (inventory() or {})[id] then unlock[id] = false end end
	if next(unlock) then pcall(fire, "UnitService", "SetLocked", unlock) end
	if app.hiddenRoll and app.hiddenRoll.object.Parent then app.hiddenRoll.object.Visible = app.hiddenRoll.visible end
	for _, connection in ipairs(app.connections) do connection:Disconnect() end
	for _, connection in ipairs(app.popupConnections) do connection:Disconnect() end
	for _, dispose in ipairs(app.disposers) do pcall(dispose) end
	if gui.Parent then gui:Destroy() end
end
local shutdown = make("BindableEvent", {Parent = gui, Name = "Shutdown"})
connect(shutdown.Event, cleanup)
connect(gui.Destroying, cleanup)
connect(unload.Activated, cleanup)
