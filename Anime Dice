local function animate(open)
	openSerial = openSerial + 1
	local serial = openSerial
	if open then window.Visible = true; reopen.Visible = false; layout() else popup.Visible = false end
	TweenService:Create(window, TweenInfo.new(0.23, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = open and 0 or 1}):Play()
	TweenService:Create(scale, TweenInfo.new(0.23, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = open and 1 or 0.96}):Play()
	if not open then task.delay(0.24, function()
		if app.alive and serial == openSerial then window.Visible = false; reopen.Visible = true end
	end) end
end
