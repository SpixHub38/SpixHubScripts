				end
				local count, pending = unitCount(inv), pendingRollUnits(inv)
				local capacity, rollCount = math.floor(buff("Unit Storage", 100)), math.floor(buff("Rolls", 1))
				if count + pending >= capacity then
					report("AutoRoll", pending > 0 and "Waiting for rolled units to reach inventory." or "Inventory full. Free space or enable Full Kaitun."); return
				end
