		local stat = key == "Traits" and "Trait Luck" or "Grade Luck"
		weatherGated = weatherMultiplier(stat) >= app.options.weatherMinMultiplier and (currentWeather() or {remaining = 0}).remaining > 1
	end
	if weatherGated then
		if not optionalAutomation("WeatherReroll") then report(key, "Install the automation server script for weather rerolls."); return end
		local reply = invoke("SpixAutomation", "WeatherReroll", key, id, app.options.weatherMinMultiplier, true)
		if type(reply) ~= "table" or not reply.ok then
			report(key, type(reply) == "table" and tostring(reply.message) or "Waiting for weather reroll confirmation."); return
		end
	else
		-- Automatic mode replaces intermediate results, including old protected presets.
		fire(key == "Traits" and "TraitService" or "GradeService", "Roll", id, true)
		app.rerollPending = app.rerollPending or {}
		app.rerollPending[key] = {id = id, field = field, original = current, token = token, before = before,
			startedAt = os.clock(), epoch = app.rerollEpoch and app.rerollEpoch[key] or 0}
	end
	local changed = waitForChange(function()
		local now = inventory() or {}
		if not weatherGated then settleNativeRerolls(now) end
		return not now[id] or (now[id].attributes or {})[field] ~= current or tokenAmount(now, token) < before
	end, 2)
	local result = (inventory() or {})[id]
	if result and rerollReached(key, result, plan) then app.rerollTargets[key] = nil end
	report(key, tostring(entry.name) .. " → " .. plan.target .. " · " .. (changed and "Rerolled " or "Waiting · ")
		.. app.budget[key] .. " / " .. math.floor(app.options.rerollLimit))
end
