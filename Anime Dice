local function layout()
	local view = bounds.AbsoluteSize
	if view.X < 2 or view.Y < 2 then return end
	local aw, ah = math.max(1, view.X - 20), math.max(1, view.Y - 20)
	local width = mode == "minimized" and math.min(280, aw) or mode == "maximized" and math.min(960, aw) or math.min(680, aw)
	local height = mode == "minimized" and math.min(70, ah) or mode == "maximized" and math.min(850, ah) or math.min(670, ah)
	local narrow = width < 430 and mode ~= "minimized"
	local hh = narrow and 105 or 70
	window.Size = UDim2.fromOffset(width, height)
	title.Text = mode == "minimized" and "Spix Hub" or "Spix Hub | Dice & Units"
	normalPos = normalPos or Vector2.new((view.X - width) / 2, (view.Y - height) / 2)
	local pos = mode == "maximized" and Vector2.new((view.X - width) / 2, (view.Y - height) / 2)
		or mode == "minimized" and (miniPos or normalPos) or normalPos
	pos = Vector2.new(math.clamp(pos.X, 0, math.max(0, view.X - width)), math.clamp(pos.Y, 0, math.max(0, view.Y - height)))
	window.Position = UDim2.fromOffset(pos.X, pos.Y)
	header.Size = UDim2.new(1, 0, 0, hh)
	title.Size = UDim2.new(1, narrow and -32 or -168, 0, 28)
	version.Size = UDim2.new(1, narrow and -32 or -168, 0, 20)
	minimize.Position = UDim2.new(1, -140, 0, narrow and 60 or 14)
	maximize.Position = UDim2.new(1, -94, 0, narrow and 60 or 14)
	close.Position = UDim2.new(1, -48, 0, narrow and 60 or 14)
	maximize.Text = mode == "maximized" and "▣" or "□"
	minimize.Text = mode == "minimized" and "+" or "−"
	local nw = width < 500 and 102 or 136
	nav.Position, nav.Size = UDim2.fromOffset(12, hh + 12), UDim2.new(0, nw, 1, -(hh + 65))
	nav.Visible, footer.Visible = mode ~= "minimized", mode ~= "minimized"
	popup.Position, popup.Size = UDim2.fromOffset(12, hh + 7), UDim2.new(1, -24, 1, -(hh + 25))
	for name, page in pairs(pages) do
		page.Position, page.Size = UDim2.fromOffset(nw + 24, hh + 12), UDim2.new(1, -(nw + 36), 1, -(hh + 65))
		page.Visible = mode ~= "minimized" and name == app.activePage
		tabs[name].BackgroundColor3 = name == app.activePage and colors.primary or colors.panel
	end
end
