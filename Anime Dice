local function prepareSpin(inv)
	local function isActive(name)
		for _, entry in pairs(read("ActiveEntries") or {}) do
			if entry.name == name and (tonumber(entry.amount) or 1) > 0 then return true end
		end
		return false
	end
	if app.spinPending then
		if isActive(app.spinPending.name) then app.spinPending = nil; return true, false end
		if os.clock() - app.spinPending.startedAt < 10 then return false, true end
		app.spinPending = nil
	end
	local active = read("ActiveEntries") or {}
	for _, entry in pairs(active) do
		if (entry.name == "Lucky Spin" or entry.name == "Jackpot Spin") and (tonumber(entry.amount) or 1) > 0 then return true, false end
	end
	local key = app.flags.Jackpot and tokenAmount(inv, "Jackpot Spin") > 0 and "Jackpot Spin"
		or app.flags.Lucky and tokenAmount(inv, "Lucky Spin") > 0 and "Lucky Spin" or nil
	if key then
		for id, entry in pairs(inv) do
			if entry.name == key and entry.amount > 0 then
				fire("SpinService", "Use", id)
				app.spinPending = {name = key, startedAt = os.clock()}
				local ready = waitForChange(function() return isActive(key) end, 2)
				if ready then app.spinPending = nil end
				return ready, not ready
			end
		end
	end
	return false, false
end
task.spawn(function()
	while app.alive do
