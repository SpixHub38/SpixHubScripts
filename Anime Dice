			dragging, start, origin = true, i.Position, window.AbsolutePosition - bounds.AbsolutePosition
			press = i
			if i.UserInputType == Enum.UserInputType.Touch then input = i end
		end
	end)
	connect(header.InputChanged, function(i)
		if dragging and press and (i == press or press.UserInputType == Enum.UserInputType.MouseButton1
			and i.UserInputType == Enum.UserInputType.MouseMovement) then input = i end
	end)
	connect(UIS.InputChanged, function(i)
		if dragging and i == input and mode ~= "maximized" then
			local delta = i.Position - start
			local p = origin + Vector2.new(delta.X, delta.Y)
			if mode == "minimized" then miniPos = p else normalPos = p end
			layout()
		end
	end)
	connect(UIS.InputEnded, function(i)
		if i == press or press and press.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging, press, input = false, nil, nil
		end
	end)
