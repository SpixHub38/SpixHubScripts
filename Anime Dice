local function sequenceDuration(sequence)
	local refs, seconds = need("TowerRefs"), 0
	for i, action in ipairs(sequence) do
		if action.action == refs.Actions.floorStarted then
			if i == 1 then seconds = seconds + (action.floor == 1 and refs.FloorStartedWaitTime.initial or refs.FloorStartedWaitTime.transition)
			else seconds = seconds + (sequence[i - 1].action == refs.Actions.memberDefeated and refs.FloorStartedWaitTime.transition or refs.FloorStartedWaitTime.repeated) end
		else seconds = seconds + (refs.ActionWaitTime[action.action] or 0) end
	end
	return seconds
end
