local kaitunTargets = {
	AutoRoll = true, FastRoll = true, SkipAnimation = true, Collect = true, Rebirth = true,
	BuyDice = true, EquipDice = true, Place = true, Team = true, Level = true, Upgrades = true,
	Quests = true, Gear = true, KeepBest = true, KeepMutations = true, AntiAFK = true, Tower = true,
	Lucky = true, Jackpot = true, Fuse = true, Sell = false, Traits = true, Grades = true,
	SmartSell = true, Overflow = true, RareProtection = true, WeatherReroll = false,
}
local function predictedFloors(cfg, units)
	local team = {}
	for i = 1, math.min(4, #units) do
		local unit = units[i]
		local health = score(unit.cfg, "health", unit.entry.attributes)
		if health and health > 0 and unit.value > 0 then
			table.insert(team, {damage = unit.value * buff("Damage Multiplier", 1), health = health * buff("Health Multiplier", 1)})
		end
	end
	local member, cleared = 1, 0
	for floor = 1, math.min(cfg.maxFloors or 100, 200) do
		local health, damage = cfg.enemyHealth(floor), cfg.enemyDamage(floor)
		if type(health) ~= "number" or type(damage) ~= "number" or health <= 0 or damage <= 0 then return cleared end
		while health > 0 do
			local unit = team[member]
			if not unit then return cleared end
			local toKill, beforeDeath = math.ceil(health / unit.damage), math.ceil(unit.health / damage)
			if toKill <= beforeDeath then
				unit.health = unit.health - (toKill - 1) * damage
				health = 0
			else health = health - beforeDeath * unit.damage; member = member + 1 end
		end
		cleared = floor
	end
	return cleared
end
local function bestRerollTarget(key, role)
	local entries = need(key == "Traits" and "Traits" or "Grades")
	local stat = key == "Traits" and role .. "Multiplier" or "incomeMultiplier"
	local best, multiplier, order = nil, 0, -math.huge
	for name, cfg in pairs(entries) do
		local weight, value = cfg.weight, cfg[stat] or 1
		if type(weight) == "number" and weight > 0 and weight < math.huge
			and type(value) == "number" and value > 0 and value < math.huge then
			local rank = tonumber(cfg.order) or 0
			if value > multiplier or value == multiplier and (rank > order or rank == order and (not best or name < best)) then
				best, multiplier, order = name, value, rank
			end
		end
	end
	if best then return {target = best, role = role, multiplier = multiplier} end
end
local function rerollReached(key, entry, plan)
	local field = key == "Traits" and "trait" or "grade"
	local cfg = need(key == "Traits" and "Traits" or "Grades")[(entry.attributes or {})[field]]
	local value = cfg and (cfg[key == "Traits" and plan.role .. "Multiplier" or "incomeMultiplier"] or 1)
	-- Equivalent or stronger exclusive results also count; never reroll a finished unit.
	return type(value) == "number" and value >= plan.multiplier
end
local function autoRerollPlans(inv)
	local plans = {}
	app.rerollTargets = app.rerollTargets or {}
	local units, slots = ranked(inv, "income"), #unlockedSlots()
	local candidates, seen = {}, {}
	for i = 1, math.min(slots, #units) do
		if unitMetadata(units[i].id, units[i].entry) then
			table.insert(candidates, {unit = units[i], role = "income"}); seen[units[i].id] = true
		end
	end
	for i, unit in ipairs(ranked(inv, "damage")) do
		if i <= 4 and unit.value > 0 and not seen[unit.id] and unitMetadata(unit.id, unit.entry) then
			table.insert(candidates, {unit = unit, role = "damage"}); seen[unit.id] = true
		end
	end
	-- Preserve level, mutation and size while comparing potential without the rerolled stats.
	for _, candidate in ipairs(candidates) do
		local attributes = {}
		for name, value in pairs(candidate.unit.entry.attributes) do attributes[name] = value end
		attributes.trait, attributes.grade = nil, nil
		candidate.potential = score(candidate.unit.cfg, candidate.role, attributes) or 0
	end
	table.sort(candidates, function(a, b)
		return a.potential > b.potential or a.potential == b.potential and a.unit.id < b.unit.id
	end)
	for _, key in ipairs({"Traits", "Grades"}) do
		local pin = app.rerollTargets[key]
		local entry = pin and inv[pin.id]
		local plan = pin and bestRerollTarget(key, pin.role)
		if not app.flags[key] or not entry then
			app.rerollTargets[key] = nil
		elseif plan and unitMetadata(pin.id, entry) and rerollReached(key, entry, plan) then
			app.rerollTargets[key] = nil
		end
		local token = key == "Traits" and "Trait Reroll" or "Gems"
		if app.flags[key] and app.budget[key] < math.floor(app.options.rerollLimit)
			and tokenAmount(inv, token) - 1 >= app.options.tokenReserve then
			pin = app.rerollTargets[key]
			entry = pin and inv[pin.id]
			plan = pin and bestRerollTarget(key, pin.role)
			if pin then
				-- A downgrade must not change targets midway or release the unit to Auto Sell.
				if plan and unitMetadata(pin.id, entry) then plan.id = pin.id; plans[key] = plan end
			else
				for _, candidate in ipairs(candidates) do
					-- Grades boost income only in this game; spend Gems on plot units.
					if key == "Traits" or candidate.role == "income" then
						plan = bestRerollTarget(key, candidate.role)
						if plan and not rerollReached(key, candidate.unit.entry, plan) then
							plan.id = candidate.unit.id; plans[key] = plan; break
						end
					end
				end
			end
			if plans[key] then app.rerollTargets[key] = plans[key] end
		end
	end
	return plans
end
local function settleNativeRerolls(inv)
	inv = inv or inventory()
	if not inv then return end
	for key, pending in pairs(app.rerollPending or {}) do
		local entry = inv[pending.id]
		local spent = tokenAmount(inv, pending.token) < pending.before
			or entry and type(entry.attributes) == "table" and entry.attributes[pending.field] ~= pending.original
		if spent or not entry then
			if spent and (app.rerollEpoch and app.rerollEpoch[key] or 0) == pending.epoch then
				app.budget[key] = app.budget[key] + 1
			end
			app.rerollPending[key] = nil
		elseif os.clock() - pending.startedAt >= 10 then
			-- Signals have no acknowledgement. Allow a slow retry after a bounded wait.
			app.rerollPending[key] = nil
			if app.flags[key] then report(key, "No reroll confirmed. Rechecking your unit and tokens.") end
		end
	end
end
app.settleRerolls = function() settleNativeRerolls() end
local function kaitunOwnedDice()
	local dice, owned = need("Dice"), read("OwnedDice")
	assert(type(owned) == "table", "Waiting for owned dice.")
	local equipped = read("Dice")
	local current = dice.Get(equipped)
	local best, luck = equipped, current and current.luck or 0
	for id, cfg in pairs(dice.GetAll()) do
		if owned[id] and (cfg.luck > luck or cfg.luck == luck and (not best or id < best)) then best, luck = id, cfg.luck end
	end
	return best, luck
end
local function kaitunCashPlan(inv, income)
	local best, choice, value = nil, nil, -math.huge
	local function consider(action, price, utility, id, payback)
		if not readyToSpend(price) or utility <= 0 or utility ~= utility or utility >= math.huge then return end
		if payback and (payback > app.options.maxPayback or payback >= (app.kaitun.rebirthETA or math.huge)) then return end
		local scoreValue = utility / math.max(1, price)
		if scoreValue > value or scoreValue == value and tostring(id) < tostring(choice) then best, choice, value = action, id, scoreValue end
	end
	local owned, tree = read("Upgrades"), need("Tree")
	assert(type(owned) == "table", "Waiting for upgrades.")
	for id, cfg in pairs(need("Upgrades")) do
		local parent = tree.GetParent(id)
		if id ~= "Start" and not owned[id] and (not parent or parent == "Start" or owned[parent]) then
			local utility, moneyGain = 0, 0
			for stat, bonus in pairs(cfg.buffs or {}) do
				local amount, current = bonus.amount or 0, buff(stat, 1)
				local relative = bonus.bucket == "multiplier" and amount - 1 or amount / math.max(current, 0.001)
				local weight = stat == "Money Multiplier" and 8 or stat == "Luck" and 6 or stat == "Roll Duration" and 5 or 0.25
				if stat == "Unit Storage" then
					weight = app.kaitun.spaceLow and 20 or 2
					utility = utility + weight * math.max(0, relative)
				elseif stat == "Roll Duration" then utility = utility + weight * math.max(0, -relative)
				else utility = utility + weight * math.max(0, relative) end
				if stat == "Money Multiplier" then moneyGain = income * math.max(0, relative) end
			end
			consider("Upgrades", cfg.price, utility, id, moneyGain > 0 and cfg.price / moneyGain or nil)
		end
	end
	local dice, ownedDice = need("Dice"), read("OwnedDice")
	local bestOwned, ownedLuck = kaitunOwnedDice()
	-- An already-owned upgrade costs nothing; equip it before considering a purchase.
	if bestOwned == read("Dice") then
		for id, cfg in pairs(dice.GetAll()) do
			if cfg.price and not ownedDice[id] and cfg.luck > ownedLuck then
				consider("BuyDice", cfg.price, 6 * math.log(cfg.luck / math.max(1, ownedLuck)), id)
			end
		end
	end
	for _, i in ipairs(unlockedSlots()) do
		local slots = read("Slots") or {}
		local slot = slots[tostring(i)] or slots[i]
		local entry = slot and inv[slot.unitId]
		if config(entry) and not app.kaitun.needsPlacement then
			local cfg, attrs = config(entry), entry.attributes or {}
			local upgraded = table.clone(attrs); upgraded.level = (attrs.level or 1) + 1
			local old, new = score(cfg, "income", attrs), score(cfg, "income", upgraded)
			local price = need("UnitUtil").GetLevelPrice(entry.name, attrs)
			local gain = old and new and (new - old) * buff("Money Multiplier", 1) or 0
			if gain > 0 and type(price) == "number" then consider("Level", price, 8 * gain / math.max(1, income), i, price / gain) end
		end
	end
	-- Smart Sell owns spare units. Never allocate cash to a triple it will sell.
	if not app.flags.SmartSell and not app.flags.Overflow then
		local needs = unitNeeds(inv)
		if needs.fusion then consider("Fuse", needs.fusion.price, math.min(0.1, needs.fusion.gain / math.max(1, income))) end
	end
	return best, choice
end
local function updateKaitun()
	if not app.flags.Kaitun then return end
	app.kaitun.ready, app.kaitun.cashAction, app.kaitun.cashChoice = false, nil, nil
	for _, name in ipairs({"Data", "Buffs", "Units", "Plot", "Dice", "Rebirths", "Upgrades", "Tree", "Grades", "Traits", "UnitUtil"}) do
		if not app.modules[name] then report("Kaitun", "Waiting for " .. name .. " data."); return end
	end
	local inv, balance, rebirth, slots, team = inventory(), cash(), read("Rebirth"), read("Slots"), read("TowerTeam")
	assert(inv and balance and type(rebirth) == "number" and type(slots) == "table" and type(team) == "table", "Waiting for your profile.")
	local income, banked, current, wanted = 0, 0, {}, {}
	local units, indices = ranked(inv, "income"), unlockedSlots()
	for index, i in ipairs(indices) do
		local slot = slots[tostring(i)] or slots[i]
		if slot then
			local entry = inv[slot.unitId]
			income = income + (score(config(entry), "income", entry and entry.attributes) or 0)
			if type(slot.balance) == "number" and slot.balance > 0 and slot.balance < math.huge then banked = banked + slot.balance end
			if slot.unitId then current[slot.unitId] = true end
		end
		if units[index] then wanted[units[index].id] = true end
	end
	income = income * buff("Money Multiplier", 1)
	app.kaitun.needsPlacement = false
	for id in pairs(wanted) do if not current[id] then app.kaitun.needsPlacement = true end end
	for id in pairs(current) do if not wanted[id] then app.kaitun.needsPlacement = true end end
	local combat = ranked(inv, "damage")
	app.kaitun.needsTeam = false
	for i = 1, 4 do if (team[i] or team[tostring(i)]) ~= (combat[i] and combat[i].id) then app.kaitun.needsTeam = true end end
	app.kaitun.bestDice = kaitunOwnedDice()
	local count, pending, capacity = unitCount(inv), pendingRollUnits(inv), math.floor(buff("Unit Storage", 100))
	app.kaitun.spaceLow = count + pending + math.floor(buff("Rolls", 1)) > capacity or count >= math.ceil(capacity * 0.85)
	local nextRebirth = need("Rebirths").GetNext(rebirth)
	local shortfall = nextRebirth and math.max(0, nextRebirth.cost - balance - banked) or math.huge
	app.kaitun.rebirthETA = shortfall == 0 and 0 or income > 0 and shortfall / income or math.huge
	app.kaitun.saving = nextRebirth ~= nil and (shortfall == 0 or app.kaitun.rebirthETA <= 12)
	app.kaitun.ready = true
	app.kaitun.rerolls = autoRerollPlans(inv)
	if not app.kaitun.saving then app.kaitun.cashAction, app.kaitun.cashChoice = kaitunCashPlan(inv, income) end
	local phase = "Farming income and rolls"
	if #units == 0 then phase = "Rolling your first units"
	elseif app.kaitun.needsPlacement then phase = "Placing best income units"
	elseif app.kaitun.spaceLow then phase = "Clearing space for more rolls"
	elseif app.kaitun.saving then phase = balance >= nextRebirth.cost and "Ready to rebirth" or "Collecting cash for rebirth"
	elseif app.kaitun.bestDice ~= read("Dice") then phase = "Equipping best owned dice"
	elseif app.kaitun.cashAction then phase = "Improving " .. (app.kaitun.cashAction == "Level" and "plot income" or tostring(app.kaitun.cashChoice)) end
	app.kaitun.phase = phase
	-- Towers and gear are optional: missing extensions never stop core farming.
	if app.modules.Towers and not app.tower.owned and os.clock() >= (app.kaitun.towerCheck or 0) then
		local best, bestPriority, bestFloors = nil, -math.huge, 0
		for id, cfg in pairs(need("Towers").GetAll()) do
			local floors = predictedFloors(cfg, combat)
			local priority = cfg.maxFloors and floors >= cfg.maxFloors and 1000 + (cfg.order or 0) or floors
			if floors > 0 and (priority > bestPriority or priority == bestPriority and (not best or id < best)) then best, bestPriority, bestFloors = id, priority, floors end
		end
		app.options.towerId, app.kaitun.towerFloors = best, bestFloors
		app.kaitun.towerCheck = os.clock() + 5
	end
	report("Kaitun", phase .. " · rebirth " .. rebirth .. "\n" .. compact(income) .. "/s · " .. count .. "/" .. capacity .. " units")
end
local function kaitunActionReady(key)
	if not app.flags.Kaitun then return true end
	if app.kaitun.ready == false then return key == "EquipDice" end
	if key == "Place" then return app.kaitun.needsPlacement ~= false end
	if key == "Team" then return app.kaitun.needsTeam ~= false end
	if key == "EquipDice" then return app.kaitun.bestDice ~= read("Dice") end
	if key == "Traits" or key == "Grades" then return app.kaitun.rerolls and app.kaitun.rerolls[key] ~= nil end
	if key == "BuyDice" or key == "Level" or key == "Upgrades" or key == "Fuse" then return app.kaitun.cashAction == key and not app.kaitun.saving end
	return true
end
local function actionRetryDelay(key, success, standard)
	app.failures[key] = success and 0 or math.min(5, (app.failures[key] or 0) + 1)
	return success and standard or math.min(30, 2 ^ app.failures[key])
end
app.onToggle = function(key, enabled)
	if key == "Kaitun" then
		if enabled and not app.kaitun.saved then
			local saved = {}
			for name in pairs(kaitunTargets) do saved[name] = app.flags[name] == true end
			app.kaitun.saved, app.kaitun.towerId = saved, app.options.towerId
			app.kaitun.rerolls, app.kaitun.cashAction = {}, nil
			app.kaitun.saving, app.kaitun.towerCheck, app.kaitun.ready = false, 0, false
			for name, value in pairs(kaitunTargets) do toggle(name, value, true) end
			report(key, "All progression workers are managed. Manual toggles take over.")
		elseif not enabled and app.kaitun.saved then
			local saved = app.kaitun.saved
			app.kaitun.saved, app.kaitun.saving, app.kaitun.ready = nil, false, nil
			app.options.towerId = app.kaitun.towerId
			app.kaitun.rerolls, app.kaitun.cashAction = {}, nil
			for name, value in pairs(saved) do toggle(name, value, true) end
			report(key, "Paused. Your previous toggles were restored.")
		end
	elseif key == "Traits" or key == "Grades" then
		app.rerollTargets = app.rerollTargets or {}
		app.rerollTargets[key] = nil
	elseif key == "AutoRoll" then
		pcall(nativeRoll, enabled or app.flags.Lucky or app.flags.Jackpot)
	elseif key == "Tower" then
		if enabled then app.tower.stopping = false
		else app.tower.stopping = app.tower.owned end
	elseif key == "Sell" then
		if enabled then
			if app.nativeSell == nil then app.nativeSell = read("AutoSell") end
			pcall(fire, "SellService", "UpdateAutoSell", 0)
		end
		-- syncLocks restores native Auto Sell only after every protected worker is off.
	elseif key == "AntiAFK" then
		report(key, enabled and "Watching for idle. Built-in AFK rejoin remains active." or "Paused")
	elseif key == "Overflow" then
		if not enabled then app.overflowActive = false end
	elseif key == "SmartSell" then
		app.overflowActive = false
		report(key, enabled and "Keeping your best income and combat units. Selling weaker units of any rarity." or "Paused")

	end
end

local function recordUnitArrival(id)
	if not app.alive or type(id) ~= "string" then return end
	local watch = app.unitWatch
	if watch.initialized and not watch.known[id] then watch.queue[id] = os.clock() end
	watch.known[id] = true
end
local function observeInventory(inv)
	local watch = app.unitWatch
	if not watch.initialized then
		for id in pairs(inv) do watch.known[id] = true end
		watch.initialized = true
		return
	end
	for id in pairs(inv) do recordUnitArrival(id) end
	for id in pairs(watch.known) do if not inv[id] then watch.known[id], watch.queue[id] = nil, nil end end
end
local function protectionSummary(inv, needs)
	local counts = {locked = 0, trophies = 0, needed = 0, pending = 0, fusion = 0, unknown = 0}
	for id, why in pairs(needs.reasons) do
		if config(inv[id]) then
			local key = why == "Manual lock" and "locked" or why == "Trophy" and "trophies"
				or why == "Pending roll" and "pending" or (why == "Fusion reserve" or why == "Unverified fusion") and "fusion"
				or (why == "Unknown item" or why == "Incomplete stats") and "unknown" or "needed"
			counts[key] = counts[key] + 1
		end
	end
	local parts = {}
	for _, key in ipairs({"locked", "trophies", "needed", "pending", "fusion", "unknown"}) do
		if counts[key] > 0 then table.insert(parts, counts[key] .. " " .. key) end
	end
	return #parts > 0 and table.concat(parts, " · ") or "New units are still settling."
end
local function unlockLowIncomeSpares()
	if inventoryRequestPending() then unlockSpareStatus.Text = "Waiting for the current inventory request."; return end
	if read("PendingTrade") or app.travel.pausing then
		unlockSpareStatus.Text = "Waiting for your trade or teleport to finish."; return
	end
	if not app.props.EquippedUnitReady then unlockSpareStatus.Text = "Waiting for your roster."; return end
	local inv = assert(inventory(), "Waiting for inventory.")
	pendingRollUnits(inv)
	local needs, changes, count = saleNeeds(inv), {}, 0
	for _, unit in ipairs(needs.trash) do
		if unit.entry.attributes.locked then
			changes[unit.id], count = false, count + 1
			if count >= 100 then break end
		end
	end
	if count == 0 then
		app.unlockSpareRequested = false
		unlockSpareStatus.Text = (app.unlockSpareTotal or 0) > 0 and ("Unlocked " .. app.unlockSpareTotal .. " spares. Cleanup can continue.")
			or ("No weak locks to clear. " .. protectionSummary(inv, needs))
		return
	end
	app.unlockSpareAttempts = (app.unlockSpareAttempts or 0) + 1
	fire("UnitService", "SetLocked", changes)
	local changed = waitForChange(function()
		local current = inventory() or {}
		for id in pairs(changes) do if current[id] and (current[id].attributes or {}).locked then return false end end
		return true
	end, 2)
	if changed then
		for id in pairs(changes) do app.ownedLocks[id] = nil end
		app.unlockSpareTotal = (app.unlockSpareTotal or 0) + count
		app.unlockSpareAttempts = 0
		unlockSpareStatus.Text = "Unlocked " .. app.unlockSpareTotal .. " spares. Checking remaining locks."
	elseif app.unlockSpareAttempts >= 3 then
		app.unlockSpareRequested = false
		unlockSpareStatus.Text = "The game did not confirm the unlock. Try again after current actions finish."
	end
end
local function overflowGoal(count, capacity)
	if not app.flags.Overflow or app.flags.SmartSell then app.overflowActive = false; return nil end
	if count >= math.ceil(capacity * 0.95) then app.overflowActive = true end
	local target = math.max(1, math.floor(capacity * 0.8))
	if not app.overflowActive or count <= target then app.overflowActive = false; return nil end
	return target
end
local function inventorySweep()
	if inventoryRequestPending() then report("SmartSell", "Waiting for the current inventory request."); return end
	local inv = assert(inventory(), "Waiting for inventory.")
	observeInventory(inv)
	pendingRollUnits(inv)
	if app.inventoryBusy or app.travel.pausing or read("PendingTrade") then return end
	if not app.props.EquippedUnitReady then
		report("SmartSell", "Waiting for your roster."); return
	end
	local needs, ids, reason = saleNeeds(inv), {}, nil
	local capacity, count = math.floor(buff("Unit Storage", 100)), unitCount(inv)
	local target = overflowGoal(count, capacity)
	if app.flags.SmartSell or target then
		reason = app.flags.SmartSell and "Smart" or "Overflow"
		local limit = math.min(100, target and count - target or 100)
		for _, unit in ipairs(needs.trash) do
			table.insert(ids, unit.id)
			if #ids >= limit then break end
		end
	end

	if #ids == 0 then
		if app.flags.SmartSell then report("SmartSell", "Kept: " .. protectionSummary(inv, needs)) end
		if app.flags.Overflow then report("Overflow", "Storage " .. count .. " / " .. capacity .. " · threshold 95%") end
		return
	end
	local key = reason == "Overflow" and "Overflow" or "SmartSell"
	if app.travel.pausing or read("PendingTrade") or not app.alive then return end
	-- Native selling refuses locked units. Clear only this verified nonvaluable batch.
	local unlock = {}
	for _, id in ipairs(ids) do
		if (inv[id].attributes or {}).locked then unlock[id] = false end
	end
	if next(unlock) then
		fire("UnitService", "SetLocked", unlock)
		waitForChange(function()
			local current = inventory() or {}
			for id in pairs(unlock) do
				if current[id] and (current[id].attributes or {}).locked then return false end
			end
			return true
		end, 2)
	end
	-- Unlock confirmation yields: recheck value, roster, trade and toggles before selling.
	if not app.alive or app.travel.pausing or read("PendingTrade") or not app.props.EquippedUnitReady
		or not (app.flags.SmartSell or app.flags.Overflow) then return end
	local current = assert(inventory(), "Waiting for inventory.")
	pendingRollUnits(current)
	local fresh, eligible, confirmed = saleNeeds(current), {}, {}
	for _, unit in ipairs(fresh.trash) do eligible[unit.id] = true end
	local remaining = math.huge
	if not app.flags.SmartSell then
		local currentCapacity = math.floor(buff("Unit Storage", 100))
		local currentCount = unitCount(current)
		local target = overflowGoal(currentCount, currentCapacity)
		if not target then return end
		remaining = currentCount - target
	end
	for _, id in ipairs(ids) do
		if eligible[id] and current[id] and not (current[id].attributes or {}).locked and #confirmed < remaining then
			table.insert(confirmed, id)
		end
	end
	ids = confirmed
	if #ids == 0 then report(key, "Waiting for unlocks or changes to unit value."); return end
	local earned, sold = invoke("SellService", "SellInventory", ids)
	if type(earned) == "number" and earned >= 0 and earned < math.huge and type(sold) == "number"
		and sold >= 0 and sold <= #ids and sold % 1 == 0 then
		if sold > 0 then
			waitForChange(function()
				local current, missing = inventory() or {}, 0
				for _, id in ipairs(ids) do if not current[id] then missing = missing + 1 end end
				return missing >= sold
			end, 1)
			local current = inventory() or {}
			for _, id in ipairs(ids) do if not current[id] then app.unitWatch.queue[id] = nil end end
			report(key, "Sold " .. sold .. " weaker units · earned " .. compact(earned) .. " cash.")
		else report(key, "No sale confirmed. Checking your remaining spares.") end
	else report(key, "Waiting for the game's sale confirmation.", true) end
end
task.spawn(function()
	while app.alive do
