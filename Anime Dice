local function remote(namespace, kind, name)
	local network = RS:FindFirstChild("Network")
	local folder = network and (namespace == "" and network or network:FindFirstChild(namespace))
	local group = folder and folder:FindFirstChild(kind)
	local object = group and group:FindFirstChild(name)
	assert(object and object:IsA(kind == "RF" and "RemoteFunction" or "RemoteEvent"),
		"Missing " .. namespace .. "/" .. name .. " in this game version.")
	return object
end
local function fire(namespace, name, ...)
	remote(namespace, "RE", name):FireServer(...)
end
local function invoke(namespace, name, ...)
	local key = namespace .. "/" .. name
	assert(not app.requests[key], "A " .. name .. " request is still pending.")
	local args, request = table.pack(...), {done = false}
	local budgetEpoch = app.rerollEpoch and app.rerollEpoch[args[1]] or 0
	local object = remote(namespace, "RF", name)
	local reservation
	if namespace == "RollService" and name == "RollDice" then
		local baseline = {}
		for id in pairs(inventory() or {}) do baseline[id] = true end
		local controller = app.modules.Buffs
		local ok, amount = pcall(function() return controller.GetBuff("Rolls") end)
		local count = ok and type(amount) == "number" and amount == amount and amount > 0 and amount < math.huge and math.floor(amount) or 1
		reservation = {baseline = baseline, remaining = count}
		table.insert(app.rollReservations, reservation)
	end
	app.requests[key] = request
	task.spawn(function()
		request.result = table.pack(pcall(object.InvokeServer, object, table.unpack(args, 1, args.n)))
		if reservation then
			local results = request.result[1] and request.result[2]
			reservation.expected, reservation.remaining = {}, 0
			if type(results) == "table" then
				for _, result in ipairs(results) do
					if type(result) == "table" and app.modules.Units and app.modules.Units.entries[result.result] then
						local rewardKey = rollKey(result.result, result.mutation)
						reservation.expected[rewardKey] = (reservation.expected[rewardKey] or 0) + 1
						reservation.remaining = reservation.remaining + 1
					end
				end
			end
		end
		-- Keep ownership correct even if a tower response arrives after our timeout.
		if namespace == "Towers" and request.result[1] then
			if name == "PlayTower" and request.result[2] == true then
				app.tower.owned, app.tower.id = true, args[1]
				if not app.flags.Tower then app.tower.stopping = true end
			elseif name == "CompleteTowerFloor" and type(request.result[2]) == "table" then
				if app.sequenceDuration then
					local ok, seconds = pcall(app.sequenceDuration, request.result[2])
					if ok and type(seconds) == "number" and seconds >= 0 and seconds < math.huge then app.tower.nextAt = os.clock() + seconds + 0.1 end
				end
				for _, action in ipairs(request.result[2]) do
					if type(action) == "table" and action.action == "ended" then app.tower.owned, app.tower.stopping = false, false end
				end
			end
		end
		if namespace == "SpixAutomation" and name == "WeatherReroll" and request.result[1]
			and type(request.result[2]) == "table" and request.result[2].spent == true and app.budget[args[1]]
			and (app.rerollEpoch and app.rerollEpoch[args[1]] or 0) == budgetEpoch then
			app.budget[args[1]] = app.budget[args[1]] + 1
		end
		request.done = true
		if app.requests[key] == request then app.requests[key] = nil end
		if not app.alive and namespace == "Towers" and app.cleanupTower then app.cleanupTower() end
	end)
	local deadline = os.clock() + 8
	while not request.done and app.alive and os.clock() < deadline do task.wait(0.05) end
	assert(request.done, name .. " is waiting for the server; no duplicate request sent.")
	assert(request.result[1], tostring(request.result[2]))
	return table.unpack(request.result, 2, request.result.n)
end
local function waitForChange(predicate, seconds)
	local deadline = os.clock() + seconds
	repeat
		if predicate() then return true end
		if not app.alive then return false end
		task.wait(0.07)
	until os.clock() >= deadline
	return predicate()
end
local function optionalAutomation(name)
	local network = RS:FindFirstChild("Network")
	local folder = network and network:FindFirstChild("SpixAutomation")
	local rf = folder and folder:FindFirstChild("RF")
	local object = rf and rf:FindFirstChild(name)
	return object and object:IsA("RemoteFunction") and object or nil
end
local function readyToSpend(price, action)
	if type(price) ~= "number" or price < 0 or price >= math.huge or price ~= price then return false end
	local balance = cash()
	if app.flags.Rebirth and app.modules.Rebirths and type(read("Rebirth")) == "number" then
		local nextRebirth = app.modules.Rebirths.GetNext(read("Rebirth"))
		if balance and nextRebirth and balance >= nextRebirth.cost then return false end
	end
	if not balance or balance < price + app.options.cashReserve then return false end
	if app.flags.Kaitun then
		if app.kaitun.saving or app.kaitun.ready == false then return false end
		if action and app.kaitun.cashAction ~= action then return false end
		return price <= (balance - app.options.cashReserve) * app.options.kaitunSpendPercent / 100
	end
	return true
end
local function buff(name, default)
	local controller = app.modules.Buffs
	local ok, value = pcall(function() return controller.GetBuff(name) end)
	return ok and type(value) == "number" and value > 0 and value < math.huge and value or default
end
local function currentWeather()
	local active, cfg = app.props.ActiveWeather, app.modules.WeatherConfig
	if not app.props.ActiveWeatherReady or not cfg or type(active) ~= "table" or type(active.name) ~= "string"
		or type(active.startedAt) ~= "number" or type(active.duration) ~= "number" then return nil end
	local remaining = active.startedAt + active.duration - workspace:GetServerTimeNow()
	if remaining <= 0 or remaining ~= remaining or remaining >= math.huge then return nil end
	local ok, weather = pcall(cfg.Get, active.name)
	if not ok or type(weather) ~= "table" then return nil end
	return {name = active.name, remaining = remaining, buffs = weather.buffs or {}}
end
local function weatherMultiplier(stat)
	local weather = currentWeather()
	local value = weather and weather.buffs[stat]
	if not value or type(value.amount) ~= "number" or value.amount ~= value.amount or value.amount >= math.huge then return 1 end
	if value.bucket == "multiplier" then return math.max(0, value.amount)
	elseif value.bucket == "percentage" or value.bucket == "base" then return math.max(0, 1 + value.amount) end
	return 1
end
local function weatherAllows(key)
	if not app.flags.WeatherReroll then return true end
	local stat = key == "Traits" and "Trait Luck" or "Grade Luck"
	return weatherMultiplier(stat) >= app.options.weatherMinMultiplier and (currentWeather() or {remaining = 0}).remaining > 1
end
local function gearDominates(stronger, weaker)
	if stronger.slot ~= weaker.slot then return false end
	local stats, better = {}, false
	for stat in pairs(stronger.buffs or {}) do stats[stat] = true end
	for stat in pairs(weaker.buffs or {}) do stats[stat] = true end
	for stat in pairs(stats) do
		local a, b = (stronger.buffs or {})[stat], (weaker.buffs or {})[stat]
		if a and b and a.bucket ~= b.bucket then return false end
		local bucket = a and a.bucket or b.bucket
		if bucket ~= "multiplier" and bucket ~= "percentage" and bucket ~= "base" then return false end
		local neutral = bucket == "multiplier" and 1 or 0
		local av, bv = a and a.amount or neutral, b and b.amount or neutral
		if type(av) ~= "number" or type(bv) ~= "number" or av ~= av or bv ~= bv
			or av >= math.huge or bv >= math.huge or av < bv then return false end
		if av > bv then better = true end
	end
	return better
end
local function gearWeights()
	local focus = app.options.gearFocus
	if app.flags.Kaitun then focus = app.kaitun.saving and "Money" or "Balanced" end
	if focus == "Auto" then
		focus = app.flags.Kaitun and (app.kaitun.saving and "Money" or "Balanced") or "Balanced"
	end
	local weights = {Luck = 1, ["Money Multiplier"] = 1, ["Damage Multiplier"] = 1,
		["Health Multiplier"] = 1, ["Trait Luck"] = 0.25, ["Grade Luck"] = 0.25, Walkspeed = 0.1}
	if focus == "Money" then weights["Money Multiplier"] = 8
	elseif focus == "Luck" then weights.Luck = 8
	elseif focus == "Combat" then weights["Damage Multiplier"], weights["Health Multiplier"] = 8, 4 end
	return weights
end
local function gearSetScore(selection, entries, weights)
	local buckets = {}
	for _, name in pairs(selection) do
		local cfg = name and entries[name]
		for stat, value in pairs(cfg and cfg.buffs or {}) do
			local amount = value.amount
			if type(amount) == "number" and amount == amount and amount < math.huge then
				local item = buckets[stat] or {base = 0, percent = 1, multiplier = 1}
				if value.bucket == "base" then item.base = item.base + amount
				elseif value.bucket == "percentage" then item.percent = item.percent + amount
				elseif value.bucket == "multiplier" then item.multiplier = item.multiplier * amount end
				buckets[stat] = item
			end
		end
	end
	local result, defaults = 0, need("BuffsConfig").GetAllBuffs()
	for stat, item in pairs(buckets) do
		local default = defaults[stat] and defaults[stat].default or 1
		local factor = (default + item.base) / math.max(default, 0.001) * item.percent * item.multiplier
		result = result + (weights[stat] or 0.1) * math.log(math.max(0.001, factor))
	end
	return result
end
local function bestGear(inv, equipped)
	local gear, choices = need("GearConfig"), {}
	for _, slot in ipairs(gear.slots) do choices[slot] = {} end
	for id, entry in pairs(inv) do
		local cfg = gear.entries[entry.name]
		if cfg and choices[cfg.slot] and id == entry.name and (tonumber(entry.amount) or 0) > 0 then
			table.insert(choices[cfg.slot], entry.name)
		end
	end
	for _, list in pairs(choices) do table.sort(list) end
	local selection, best, bestScore, bestChanges, visits = {}, {}, -math.huge, math.huge, 0
	local weights = gearWeights()
	local function visit(index)
		if visits >= 10000 then return end
		if index > #gear.slots then
			visits = visits + 1
			local value, changes = gearSetScore(selection, gear.entries, weights), 0
			for _, slot in ipairs(gear.slots) do if (selection[slot] or nil) ~= equipped[slot] then changes = changes + 1 end end
			if value > bestScore + 1e-9 or math.abs(value - bestScore) <= 1e-9 and changes < bestChanges then
				best, bestScore, bestChanges = table.clone(selection), value, changes
			end
			return
		end
		local slot = gear.slots[index]
		local list = choices[slot]
		if #list == 0 then selection[slot] = false; visit(index + 1)
		else for _, name in ipairs(list) do selection[slot] = name; visit(index + 1) end end
	end
	visit(1)
	return best
end
-- Shared deterministic need analysis. The server derives its own context and rechecks it.
local function analyzeUnitNeeds(inv, ctx)
	local keep, reasons, units = {}, {}, {}
	local function retain(id, why) keep[id], reasons[id] = true, reasons[id] or why end
	for id in pairs(ctx.inUse or {}) do retain(id, "In use") end
	for _, id in pairs(ctx.selected or {}) do retain(id, "Reroll target") end
	for id, entry in pairs(inv) do
		local unit = ctx.metadata(id, entry)
		if unit then
			unit.damage, unit.health = ctx.score(unit.cfg, "damage", entry.attributes), ctx.score(unit.cfg, "health", entry.attributes)
			if not unit.damage or not unit.health then retain(id, "Incomplete stats")
			else table.insert(units, unit) end
			local a = entry.attributes
			local grade, trait = ctx.grades[a.grade], ctx.traits[a.trait]
			local sPlus = ctx.grades["S+"]
			if a.locked and not (ctx.ignoreLocks or {})[id] then retain(id, "Manual lock") end
			if a.mutation or unit.cfg.variant or unit.cfg.limited or grade and (grade.protected
				or sPlus and grade.order >= sPlus.order) or trait and trait.protected then retain(id, "Trophy") end
		else retain(id, "Unknown item") end
	end
	local function sorted(stat)
		local out = {}
		for _, unit in ipairs(units) do table.insert(out, unit) end
		table.sort(out, function(a, b) return a[stat] > b[stat] or a[stat] == b[stat] and a.id < b.id end)
		return out
	end
	local slots = 0
	for i = 1, ctx.plot.GetMaxSlots() do
		if ctx.rebirth + 1 >= ctx.plot.GetSlotRebirthRequirement(i) then slots = slots + 1 end
	end
	local income, damage, health = sorted("income"), sorted("damage"), sorted("health")
	local incomeLimit = math.min(#income, slots + 2)
	for i = 1, incomeLimit do retain(income[i].id, "Plot and next rebirth") end
	for i = 1, math.min(4, #damage) do retain(damage[i].id, "Combat team") end
	for i = 1, math.min(2, #health) do retain(health[i].id, "Combat reserve") end
	local core, fusion = {}, nil
	for id in pairs(keep) do core[id] = true end
	-- Reserve one useful, affordable triple. Random fusion never consumes a needed unit.
	if ctx.fusion and ctx.fuseUtil and ctx.fuseConfig then
		local groups, names = {}, {}
		for i = #income, 1, -1 do
			local unit, a = income[i], income[i].entry.attributes
			if not keep[unit.id] and not a.locked and not a.mutation and not a.grade and not a.trait
				and (a.level or 1) == 1 and not unit.cfg.variant and not unit.cfg.limited then
				local name = unit.entry.name
				if not groups[name] then groups[name] = {}; table.insert(names, name) end
				table.insert(groups[name], unit)
			end
		end
		table.sort(names)
		local bestValue = -math.huge
		local threshold = income[incomeLimit] and income[incomeLimit].income or 0
		for _, name in ipairs(names) do
			local group = groups[name]
			if #group >= 3 then
				local ok, plan = pcall(function()
					local chance = 0
					for i = 1, 3 do chance = chance + assert(ctx.fuseUtil.GetChance(group[i].entry)) end
					local price = ctx.fuseConfig.GetCost(chance)
					if type(price) ~= "number" or price ~= price or price < 0 or price >= math.huge
						or price > math.max(0, ctx.cash or 0) * 0.05 then return nil end
					local pools = ctx.fuseUtil.BuildPools(chance)
					if type(pools) ~= "table" then return nil end
					local gain, totalWeight = 0, 0
					for _, pool in ipairs(pools) do
						if type(pool.weight) ~= "number" or pool.weight < 0 or type(pool.entries) ~= "table" or #pool.entries == 0 then return nil end
						local average = 0
						for _, result in ipairs(pool.entries) do
							local cfg = ctx.entries[result.name]
							local value = ctx.score(cfg, "income", {mutation = result.mutation})
							if not value then return nil end
							average = average + math.max(0, value - threshold)
						end
						gain, totalWeight = gain + pool.weight * average / #pool.entries, totalWeight + pool.weight
					end
					if totalWeight <= 0 then return nil end
					gain = gain / totalWeight * (ctx.moneyMultiplier or 1)
					if gain <= 0 or gain ~= gain or gain >= math.huge or price / gain > 300 then return nil end
					return {ids = {group[1].id, group[2].id, group[3].id}, price = price, gain = gain}
				end)
				if ok and plan and plan.gain / math.max(1, plan.price) > bestValue then
					fusion, bestValue = plan, plan.gain / math.max(1, plan.price)
				elseif not ok and not fusion then
					-- Retain uncertain inputs; a missing/broken pool must not turn them into trash.
					for i = 1, 3 do retain(group[i].id, "Unverified fusion") end
				end
			end
		end
	end
	if fusion then for _, id in ipairs(fusion.ids) do retain(id, "Fusion reserve") end end
	local trash = {}
	for i = #income, 1, -1 do if not keep[income[i].id] then table.insert(trash, income[i]) end end
	return {keep = keep, core = core, reasons = reasons, trash = trash, income = income, damage = damage,
		fusion = fusion, plotReserve = incomeLimit, kept = #units - #trash}
end

local function unlockedSlots()
