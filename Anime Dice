local function watchNetworkEvent(namespace, kind, name, handler, property)
	local current, connection, askedAt = nil, nil, -math.huge
	while app.alive do
		local network = RS:FindFirstChild("Network")
		local service = network and network:FindFirstChild(namespace)
		local group = service and service:FindFirstChild(kind)
		local event = group and group:FindFirstChild(name)
		if event ~= current then
			if connection then connection:Disconnect(); connection = nil end
			current, askedAt = event, -math.huge
			if property then app.props[name .. "Ready"] = false end
			if event and event:IsA("RemoteEvent") then
				connection = connect(event.OnClientEvent, function(...) if app.alive then handler(...) end end)
			end
		end
		if property and connection and not app.props[name .. "Ready"] and os.clock() - askedAt >= 3 then
			askedAt = os.clock(); pcall(current.FireServer, current)
		end
		task.wait(0.5)
	end
	if connection then connection:Disconnect() end
end
