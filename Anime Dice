	end
	local protected, groups = protection(inv), {}
	for _, unit in ipairs(ranked(inv, "income")) do
		local attributes = unit.entry.attributes or {}
		if not protected[unit.id] and not unit.cfg.limited and not unit.cfg.variant
			and not attributes.mutation and not attributes.grade and not attributes.trait
			and (attributes.level or 1) == 1 and unit.value <= app.options.fuseMaxIncome and unit.entry.amount == 1 then
			groups[unit.entry.name] = groups[unit.entry.name] or {}
			table.insert(groups[unit.entry.name], unit)
		end
	end
	local best
	for _, group in pairs(groups) do
		if #group >= 3 and (not best or group[1].value < best[1].value) then best = group end
	end
	if not best then report("Fuse", "Waiting for 3 matching spare Normal units."); return end
	local chance = 0
	for i = 1, 3 do chance = chance + assert(need("FuseUtil").GetChance(best[i].entry), "This unit cannot be fused.") end
	local price = need("FuseConfig").GetCost(chance)
	if not readyToSpend(price, "Fuse") then report("Fuse", "Fusion needs " .. compact(price) .. " cash."); return end
