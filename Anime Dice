					and not (app.flags.Jackpot and tokenAmount(inv, "Jackpot Spin") > 0) then return end
				local prepared, waiting = prepareSpin(inv)
				if waiting then report("AutoRoll", "Waiting for spin activation."); app.rollNext = os.clock() + 0.3; return end
				if not app.flags.AutoRoll and not prepared then return end
				if prepared then rollCount = 1 end
				-- Spin activation can yield; refresh storage and trade state before the roll.
				inv = assert(inventory(), "Waiting for inventory.")
				count, pending = unitCount(inv), pendingRollUnits(inv)
				capacity = math.floor(buff("Unit Storage", 100))
				if count + pending + rollCount > capacity then
					report("AutoRoll", pending > 0 and "Waiting for rolled units to reach inventory." or "Inventory full. Free space or enable Full Kaitun."); return
				end
				if not app.alive or app.travel.pausing or read("PendingTrade")
