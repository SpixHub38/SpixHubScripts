local function unitNeeds(inv, ignoreSpareLocks)
	local inUse, selected, pending = {}, {}, {}
	local slots, team, rebirth = read("Slots"), read("TowerTeam"), read("Rebirth")
	assert(type(slots) == "table" and type(team) == "table" and type(rebirth) == "number", "Waiting for your roster.")
	for _, slot in pairs(slots) do if slot.unitId then inUse[slot.unitId] = true end end
	for _, id in pairs(team) do if id then inUse[id] = true end end
	if app.props.EquippedUnit then inUse[app.props.EquippedUnit] = true end
	-- Only hold unresolved new arrivals; continuous rolls must not block older spares.
	for _, reservation in ipairs(app.rollReservations or {}) do
		if (reservation.remaining or 0) > 0 then
			for id in pairs(inv) do
				if not inUse[id] and not (reservation.baseline or {})[id] and not (app.rollClaims or {})[id] then
					inUse[id], pending[id] = true, true
				end
			end
		end
	end
	for _, key in ipairs({"Traits", "Grades"}) do
		if app.flags[key] then
			local plan = app.rerollTargets and app.rerollTargets[key]
			local id = plan and plan.id
			if id then table.insert(selected, id) end
		end
	end
	local ignoreLocks = app.ownedLocks
	if ignoreSpareLocks then
		ignoreLocks = {}
		for id in pairs(inv) do ignoreLocks[id] = true end
	end
	local needs = analyzeUnitNeeds(inv, {metadata = unitMetadata, score = score, entries = need("Units").entries,
		grades = need("Grades"), traits = need("Traits"), plot = need("Plot"), rebirth = rebirth,
		inUse = inUse, selected = selected, ignoreLocks = ignoreLocks,
		fusion = app.flags.Fuse == true, fuseUtil = app.modules.FuseUtil, fuseConfig = app.modules.FuseConfig,
		cash = math.max(0, (cash() or 0) - app.options.cashReserve), moneyMultiplier = buff("Money Multiplier", 1)})
	for id in pairs(pending) do needs.reasons[id] = "Pending roll" end
	return needs
end
-- Sale policy is independent of progression/fusion reserves and inventory lock flags.
local function saleNeeds(inv)
	local needs = unitNeeds(inv, true)
	local keep, reasons = {}, {}
	local function retain(id, why) keep[id], reasons[id] = true, reasons[id] or why end
	for id, why in pairs(needs.reasons) do
		if why == "In use" or why == "Reroll target" or why == "Pending roll"
			or why == "Unknown item" or why == "Incomplete stats" then retain(id, why) end
	end
	-- Rank by actual stats; rarity, size, mutation and grade grant no exemption.
	for i = 1, math.min(#needs.income, math.max(1, #unlockedSlots())) do
		retain(needs.income[i].id, "Best plot units")
	end
	for i = 1, math.min(4, #needs.damage) do
		if needs.damage[i].damage > 0 then retain(needs.damage[i].id, "Best combat units") end
	end
	local trash = {}
	for i = #needs.income, 1, -1 do
		local unit = needs.income[i]
		local arrived = app.unitWatch.queue[unit.id]
		if arrived and os.clock() - arrived < 2 then retain(unit.id, "Pending roll") end
		if not keep[unit.id] then table.insert(trash, unit) end
	end
	return {keep = keep, reasons = reasons, trash = trash}
end
local function protection(inv, allowFusion)
	local protected, locks = {}, {}
	local grades, traits = need("Grades"), need("Traits")
	local slots, team = read("Slots"), read("TowerTeam")
	assert(type(slots) == "table" and type(team) == "table", "Waiting for slot and team data.")
	for _, slot in pairs(slots) do if slot.unitId then protected[slot.unitId] = true end end
	for _, id in pairs(team) do if id then protected[id] = true end end
	if app.props.EquippedUnit then protected[app.props.EquippedUnit] = true end
	for _, key in ipairs({"Traits", "Grades"}) do
		local plan = app.rerollTargets and app.rerollTargets[key]
		if app.flags[key] and plan then protected[plan.id] = true end
	end
	if app.flags.SmartSell or app.flags.Overflow or app.flags.Kaitun then
		local needs = unitNeeds(inv)
		local fusionInputs = {}
		if allowFusion and needs.fusion then for _, id in ipairs(needs.fusion.ids) do fusionInputs[id] = true end end
		for id in pairs(needs.keep) do
			if not fusionInputs[id] or needs.core[id] then protected[id] = true end
		end
		-- Needed, pending and incomplete units are protected in memory, never auto-locked.
	elseif app.flags.KeepBest then
		local limit = math.max(math.floor(app.options.keepCount), #unlockedSlots())
		for i, unit in ipairs(ranked(inv, "income")) do if i <= limit then protected[unit.id] = true end end
		for i, unit in ipairs(ranked(inv, "damage")) do if i <= 4 then protected[unit.id] = true end end
	end
	for id, entry in pairs(inv) do
		local a = entry.attributes or {}
		local grade = grades[a.grade]
		local trait = traits[a.trait]
		if a.locked or app.flags.KeepMutations and a.mutation or grade and grade.protected or trait and trait.protected then protected[id] = true end
		local cfg = config(entry)
		local sPlus = grades["S+"]
		local exception = cfg and (a.mutation or cfg.variant or cfg.limited
			or grade and sPlus and grade.order >= sPlus.order)
		if exception and (app.flags.RareProtection or app.flags.SmartSell or app.flags.Overflow) then
			protected[id] = true
		end
	end
	if app.flags.SmartSell or app.flags.Overflow then
		for id in pairs(saleNeeds(inv).keep) do protected[id] = true end
	end
	return protected, locks
end
local function syncLocks(inv)
	if read("PendingTrade") then return end
	local nativeThreshold = read("AutoSell")
	if app.flags.KeepBest or app.flags.KeepMutations or app.flags.RareProtection or app.flags.SmartSell or app.flags.Overflow
		or app.flags.Sell or app.flags.AutoRoll or app.flags.Lucky or app.flags.Jackpot or app.flags.Traits or app.flags.Grades then
		if type(nativeThreshold) == "number" and nativeThreshold > 0 then
			if app.nativeSell == nil then app.nativeSell = nativeThreshold end
			fire("SellService", "UpdateAutoSell", 0)
		end
	elseif app.nativeSell ~= nil then
		fire("SellService", "UpdateAutoSell", app.nativeSell); app.nativeSell = nil
	end
	-- Safeguards are evaluated by sell/fusion selection. Never create inventory locks.
	-- Release only locks explicitly recorded as owned by this running hub.
	local changes = {}
	for id in pairs(app.ownedLocks) do
		if not inv[id] or not (inv[id].attributes or {}).locked then app.ownedLocks[id] = nil
		else changes[id] = false end
	end
	if next(changes) then fire("UnitService", "SetLocked", changes); task.wait(0.25) end
	report("KeepBest", app.flags.KeepBest and "Protecting your best income and damage units."
		or (app.flags.SmartSell or app.flags.Overflow) and "Inventory safeguards are keeping your best units." or "Best-unit protection is off.")
	report("RareProtection", (app.flags.SmartSell or app.flags.Overflow) and "Smart Sell keeps the best stats; rarity adds no protection."
		or app.flags.RareProtection and "Rare units are kept from filtered sales and fusion." or "Extra rare-unit protection is off.")
end
local function tokenAmount(inv, name)
