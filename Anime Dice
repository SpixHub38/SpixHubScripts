					app.rolls = app.rolls + 1
					local names = {}
					for _, result in ipairs(results) do table.insert(names, (result.mutation and result.mutation .. " " or "") .. tostring(result.result)) end
					rollResult.Text = "Last roll: " .. table.concat(names, ", ")
					if not app.flags.SkipAnimation then
						rollDisplay.BackgroundColor3 = colors.primary
						TweenService:Create(rollDisplay, TweenInfo.new(0.6), {BackgroundColor3 = colors.panel}):Play()
					end
					report("AutoRoll", "Rolling · " .. compact(interval) .. "s server cooldown · " .. app.rolls .. " rolls")
				else
					app.rollNext = os.clock() + math.min(0.5, math.max(0.15, interval))
					report("AutoRoll", "Server is busy or cooling down. Retrying.")
				end
			end)
			if not ok then app.rollNext = os.clock() + 2; report("AutoRoll", tostring(err):sub(1, 150), true) end
		elseif not rolling and not app.travel.pausing and app.nativeRoll ~= nil then pcall(nativeRoll, false) end
		if app.alive then
			local inv = inventory() or {}
			report("Lucky", "Owned: " .. tokenAmount(inv, "Lucky Spin") .. (app.flags.Lucky and " · using when ready" or ""))
			report("Jackpot", "Owned: " .. tokenAmount(inv, "Jackpot Spin") .. (app.flags.Jackpot and " · using when ready" or ""))
		end
		task.wait(0.1)
	end
end)

local actions = {}
function actions.Rebirth()
	local level, balance = read("Rebirth"), cash()
	assert(type(level) == "number" and balance, "Waiting for money and rebirth data.")
	local nextLevel = need("Rebirths").GetNext(level)
	if not nextLevel then report("Rebirth", "Maximum rebirth reached."); return end
	if balance < nextLevel.cost then report("Rebirth", compact(balance) .. " / " .. compact(nextLevel.cost) .. " cash"); return end
	fire("RebirthService", "Rebirth")
	local changed = waitForChange(function() return read("Rebirth") ~= level end, 2)
	report("Rebirth", changed and "Rebirth complete." or "Request sent; waiting for confirmation.")
end
function actions.BuyDice()
	local dice, owned = need("Dice"), read("OwnedDice")
	assert(type(owned) == "table", "Waiting for owned dice.")
	local _, ownedLuck = kaitunOwnedDice()
	local nextDice, nextCfg, waitingDice, waitingCfg
	for id, cfg in pairs(dice.GetAll()) do
		if cfg.price and not owned[id] and cfg.luck > ownedLuck and (not app.flags.Kaitun or id == app.kaitun.cashChoice) then
			if not waitingCfg or cfg.luck < waitingCfg.luck or cfg.luck == waitingCfg.luck and id < waitingDice then
				waitingDice, waitingCfg = id, cfg
			end
			if readyToSpend(cfg.price, "BuyDice") and (not nextCfg or cfg.luck < nextCfg.luck or cfg.luck == nextCfg.luck and id < nextDice) then
				nextDice, nextCfg = id, cfg
			end
		end
	end
	if not nextDice then
		report("BuyDice", waitingDice and ("Next: " .. waitingDice .. " · " .. compact(waitingCfg.price) .. " cash") or "You own all higher luck dice."); return
	end
	fire("DiceShopService", "BuyDice", nextDice)
	local changed = waitForChange(function() return (read("OwnedDice") or {})[nextDice] == true end, 2)
	report("BuyDice", changed and "Bought " .. nextDice .. "." or "Waiting for purchase confirmation.")
end
function actions.EquipDice()
	local dice, owned = need("Dice"), read("OwnedDice")
	assert(type(owned) == "table", "Waiting for owned dice.")
	local best, luck = dice.GetDefault(), 0
	for id, cfg in pairs(dice.GetAll()) do
		if (owned[id] or id == dice.GetDefault()) and cfg.luck > luck then best, luck = id, cfg.luck end
	end
	if read("Dice") ~= best then fire("DiceShopService", "EquipDice", best); task.wait(0.6) end
	report("EquipDice", "Best owned dice: " .. best .. " · " .. compact(luck) .. " luck")
end
function actions.Place()
	local inv, slots = inventory(), read("Slots")
	assert(inv and type(slots) == "table", "Waiting for your inventory and slots.")
	local units, indices = ranked(inv, "income"), unlockedSlots()
	local wanted, current = {}, {}
	for i = 1, math.min(#units, #indices) do wanted[units[i].id] = true end
	for _, i in ipairs(indices) do
		local slot = slots[tostring(i)] or slots[i]
		if slot and slot.unitId then current[slot.unitId] = true end
	end
	local changed = false
	for id in pairs(wanted) do if not current[id] then changed = true end end
	for id in pairs(current) do if not wanted[id] then changed = true end end
	if changed then fire("PlotService", "EquipBest"); task.wait(1.1) end
	report("Place", "Using the best " .. math.min(#units, #indices) .. " income units on your plot.")
end
function actions.Team()
	local units, team = ranked(inventory(), "damage"), read("TowerTeam")
	assert(type(team) == "table", "Waiting for your tower team.")
	local changed = false
	for i = 1, 4 do if (team[i] or team[tostring(i)]) ~= (units[i] and units[i].id) then changed = true end end
