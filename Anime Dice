		footer.Text = data and ("Cash " .. compact(cash()) .. "  ·  " .. unitCount(data) .. " units  ·  " .. (app.props.PlotId and "Own plot connected" or "Own account data"))
			or (app.moduleErrors.Data and "Game data unavailable: " .. app.moduleErrors.Data or "Waiting for the game's data controller...")
		task.wait(0.5)
	end
end)

