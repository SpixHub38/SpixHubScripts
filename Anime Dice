function actions.Gear()
	local inv, equipped = inventory(), read("EquippedGear")
	assert(inv and type(equipped) == "table", "Waiting for gear inventory.")
	local gear = need("GearConfig")
	local selection = bestGear(inv, equipped)
	for _, slot in ipairs(gear.slots) do
		local name = selection[slot]
		if name and name ~= equipped[slot] then
			if not app.flags.Gear or read("PendingTrade") then return end
			fire("GearService", "Equip", slot, name)
			local changed = waitForChange(function() return (read("EquippedGear") or {})[slot] == name end, 1.5)
			report("Gear", changed and "Equipped " .. name .. "." or "Waiting for gear confirmation.")
			return -- One equip per pass respects the shared server debounce.
		end
	end
	local names, keep = {}, math.max(1, math.floor(app.options.gearKeepCopies))
	inv = assert(inventory(), "Waiting for gear inventory.")
	equipped = read("EquippedGear") or {}
	local protectedNames = {}
	for _, name in pairs(equipped) do protectedNames[name] = true end
	for _, name in pairs(selection) do if name then protectedNames[name] = true end end
	for id, entry in pairs(inv) do
		local cfg = gear.entries[entry.name]
		if cfg and id == entry.name and entry.amount > keep and not protectedNames[id]
			and not (entry.attributes or {}).locked and not cfg.limited and not cfg.protected then
			for otherId, other in pairs(inv) do
				local stronger = gear.entries[other.name]
				if otherId == other.name and other.amount > 0 and stronger and gearDominates(stronger, cfg) then
					table.insert(names, id); break
				end
			end
		end
	end
	if #names == 0 then report("Gear", "Best gear equipped. No inferior duplicates to scrap."); return end
	local network = RS:FindFirstChild("Network")
	local service = network and network:FindFirstChild("GearService")
	local rf = service and service:FindFirstChild("RF")
	local salvage = rf and rf:FindFirstChild("SpixSalvageGear")
	if not salvage or not salvage:IsA("RemoteFunction") then
		report("Gear", "Best gear equipped. Install the salvage server script to scrap duplicates."); return
