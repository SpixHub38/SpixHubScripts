local function dropdown(page, name, provider, selection, multi)
	local f = panel(page, 78)
	label(f, name, UDim2.new(1, -24, 0, 26), UDim2.fromOffset(12, 3), 12)
	local b = button(f, "Choose  ▾", UDim2.new(1, -24, 0, 33), UDim2.fromOffset(12, 34))
	local function refreshCaption()
		if multi then
			local count = 0
			for _, yes in pairs(app.options[selection]) do if yes then count = count + 1 end end
			b.Text = count .. " selected  ▾"
		else
			local caption = tostring(app.options[selection] or "Choose")
			local ok, choices = pcall(provider)
			if ok and type(choices) == "table" then
				for _, choice in ipairs(choices) do if choice.id == app.options[selection] then caption = choice.text; break end end
			end
			b.Text = caption .. "  ▾"
		end
	end
	refreshCaption()
	app.optionRefresh[selection] = refreshCaption
	connect(b.Activated, function()
		for _, connection in ipairs(app.popupConnections) do connection:Disconnect() end
		app.popupConnections = {}
		for _, child in ipairs(popupList:GetChildren()) do if child:IsA("GuiButton") or child:IsA("TextLabel") then child:Destroy() end end
		popupTitle.Text, popup.Visible = name, true
		popupList.CanvasPosition = Vector2.new()
		local ok, choices = pcall(provider)
		if not ok or not choices or #choices == 0 then
			local l = label(popupList, "Waiting for game data...", UDim2.new(1, -5, 0, 40), UDim2.new(), 12, colors.muted); l.ZIndex = 32
			return
		end
		for i, choice in ipairs(choices) do
			if i > 250 then break end
			local selected = multi and app.options[selection][choice.id] or not multi and app.options[selection] == choice.id
			local item = button(popupList, (selected and "✓  " or "") .. choice.text,
				UDim2.new(1, -5, 0, 44), UDim2.new(), selected and colors.primary or colors.surface)
			item.ZIndex = 32
			table.insert(app.popupConnections, item.Activated:Connect(function()
				if multi then
					app.options[selection][choice.id] = not app.options[selection][choice.id]
					local yes = app.options[selection][choice.id]
					item.Text = (yes and "✓  " or "") .. choice.text
					item.BackgroundColor3 = yes and colors.primary or colors.surface
				else app.options[selection] = choice.id; popup.Visible = false end
				refreshCaption()
			end))
		end
	end)
end
local function compact(n)
	if type(n) ~= "number" then return "--" end
	local suffix = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No"}
	local i = 1
	while math.abs(n) >= 1000 and i < #suffix do n, i = n / 1000, i + 1 end
	if math.abs(n) >= 1000 then return string.format("%.2e", n * 1000 ^ (i - 1)) end
	return string.format("%.2f%s", n, suffix[i])
end
local function need(name)
	return assert(app.modules[name], "Waiting for " .. name .. (app.moduleErrors[name] and ": " .. app.moduleErrors[name] or " to load."))
end
local function read(field)
	local data = app.modules.Data
	if not data then return nil end
	local ok, value = pcall(function() return data[field]() end)
	if ok then return value end
end
local function inventory()
	local inv = read("Inventory")
	return type(inv) == "table" and inv or nil
end
local function cash()
	local value = read("Money")
	if type(value) == "number" and value >= 0 and value < math.huge and value == value then return value end
end
local function config(entry)
	return entry and app.modules.Units and app.modules.Units.entries[entry.name]
end
local function score(cfg, stat, attributes)
	if not cfg or type(cfg[stat]) ~= "function" then return nil end
	local ok, value = pcall(cfg[stat], attributes or {})
	if ok and type(value) == "number" and value >= 0 and value < math.huge and value == value then return value end
end
local function ranked(inv, stat)
	local result = {}
	for id, entry in pairs(inv or {}) do
		local cfg = config(entry)
		local value = score(cfg, stat, entry.attributes)
		if value then table.insert(result, {id = id, entry = entry, cfg = cfg, value = value}) end
	end
	table.sort(result, function(a, b) return a.value > b.value or a.value == b.value and a.id < b.id end)
	return result
end
local function unitCount(inv)
	local count = 0
	for _, entry in pairs(inv or {}) do if config(entry) then count = count + 1 end end
	return count
end
local function unitMetadata(id, entry)
	local cfg = config(entry)
	if not cfg or type(entry.attributes) ~= "table" or entry.amount ~= 1 then return nil end
	local a = entry.attributes
	local baseIncome, income = score(cfg, "income", {}), score(cfg, "income", a)
	local ok, rarity = pcall(function() return cfg.getRarity and cfg.getRarity(a) or cfg.rarity end)
	if not baseIncome or not income or not ok or type(rarity) ~= "string" then return nil end
	return {id = id, cfg = cfg, entry = entry, rarity = rarity, mutation = a.mutation,
		size = cfg.variant or "Normal", grade = a.grade or "None", baseIncome = baseIncome, income = income}
end
local function rollKey(name, mutation)
	return tostring(name) .. "\0" .. tostring(mutation or "")
end
local function pendingRollUnits(inv)
	-- Match replicated GUIDs to accepted rewards, rather than guessing network delay.
	for id in pairs(app.rollClaims) do if not inv[id] then app.rollClaims[id] = nil end end
	local total = 0
	for index = #app.rollReservations, 1, -1 do
		local reservation = app.rollReservations[index]
		if reservation.expected then
			for id, entry in pairs(inv) do
				local key = rollKey(entry.name, (entry.attributes or {}).mutation)
				if not reservation.baseline[id] and not app.rollClaims[id] and (reservation.expected[key] or 0) > 0 then
					reservation.expected[key] = reservation.expected[key] - 1
					reservation.remaining = reservation.remaining - 1
					app.rollClaims[id] = true
				end
			end
		end
		if reservation.remaining <= 0 then table.remove(app.rollReservations, index)
		else total = total + reservation.remaining end
	end
	return total
end
local function unitChoices()
	local choices = {}
	for _, unit in ipairs(ranked(inventory(), "income")) do
		table.insert(choices, {id = unit.id, text = unit.entry.name .. " · " .. compact(unit.value) .. "/s · " .. unit.id:sub(1, 6)})
	end
	return choices
end
local function mapChoices(name, orderField)
	local result = {}
	for id, value in pairs(need(name)) do
		if type(value) == "table" then table.insert(result, {id = id, text = id, order = value[orderField] or 0}) end
	end
	table.sort(result, function(a, b) return a.order < b.order or a.order == b.order and a.id < b.id end)
	return result
end

