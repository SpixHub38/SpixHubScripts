local function buyNextCar()
	if not catalog then return end

	local plot = ownPlot()
	assert(plot, "Your plot is still loading.")

	local stands = plot:FindFirstChild("RollStands")
	if not stands then return end

	for _, stand in ipairs(stands:GetChildren()) do
		if not autoBuy or not alive then return end

		if stand:IsA("Model")
			and stand.Name:match("^Stand_") then

			local prompt = stand:FindFirstChild("ClaimPrompt", true)
			local carId = stand:GetAttribute("RolledCarId")

			if not carId and prompt then
				carId = prompt:GetAttribute("CarId")
			end

			local rarityId = carRarities[carId]
				or stand:GetAttribute("RarityId")

			local previousAttempt = buyAttempts[stand]
			local retryReady = not previousAttempt
				or previousAttempt.carId ~= carId
				or os.clock() - previousAttempt.time > 25

			if rarityId
				and selectedRarities[rarityId] == true
				and prompt
				and prompt:IsA("ProximityPrompt")
				and prompt.Enabled
				and prompt.ActionText == "BUY CAR"
				and retryReady then

				buyAttempts[stand] = {
					carId = carId,
					time = os.clock(),
				}

				usePrompt(prompt, function()
					return autoBuy and alive
				end)

				setStatus(
					"Purchase attempted: "
						.. tostring(prompt.ObjectText)
						.. ". The game checks your cash.",
					colors.cyan
				)

				return
			end
		end
	end
end

local function equipBest()
	if os.clock() - lastEquip < 3 then return end

	local plot = ownPlot()
	assert(plot, "Your plot is still loading.")

	local garage = plot:FindFirstChild("Garage")
	local entrance = garage
		and garage:FindFirstChild("Entrance", true)

	local stands = plot:FindFirstChild("RollStands")
	local newCars = stands and stands:FindFirstChild("NewCars")
	local fallback = newCars and newCars:FindFirstChild("Base")

	local destination = entrance or fallback
	assert(destination, "Your garage entrance is not loaded.")

	moveTo(destination, 9)

	lastEquip = os.clock()
	endpoint("CarIndexEvent", "RemoteEvent"):FireServer("EquipBest")
	setStatus("Equip Best requested at your garage.", colors.green)
end

