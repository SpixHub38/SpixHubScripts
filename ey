local function events()
	local folder = RS:FindFirstChild("Events")
	assert(folder, "Garage events are still loading.")
	return folder
end
local function endpoint(name, kind)
	local target = events():FindFirstChild(name)
	assert(target and target:IsA(kind), name .. " is unavailable.")
	return target
end
local function refreshCatalog()
	local result = endpoint("GlobalCarsIndexRequest", "RemoteFunction"):InvokeServer()
	assert(type(result) == "table" and type(result.Cars) == "table"
		and type(result.Rarities) == "table", "Car catalog is still loading.")
	catalog = result
	table.clear(carRarities)
	for _, entry in ipairs(result.Cars) do
		if type(entry) == "table" and type(entry.Id) == "string" and type(entry.RarityId) == "string" then
			carRarities[entry.Id] = entry.RarityId
		end
	end
	for _, rarity in ipairs(result.Rarities) do
		if type(rarity) == "table" and type(rarity.Id) == "string" and selectedRarities[rarity.Id] == nil then
			selectedRarities[rarity.Id] = true
		end
	end
	return result
end
local function perform(callback)
	if busy or not alive or not gui.Parent then return end
	busy = true
	task.spawn(function()
		local ok, message = pcall(callback)
		if alive and gui.Parent then setStatus(ok and (message or "Done.") or tostring(message), ok and colors.green or colors.red) end
		busy = false
	end)
end
local function enabledRarityCount(state)
	local count = 0
	for _, entry in ipairs(type(state.Rarities) == "table" and state.Rarities or {}) do
		if type(entry) == "table" and selectedRarities[entry.Id] == true then count = count + 1 end
	end
	return count
end
local function renderRarities(state)
	for _, object in ipairs(rarityEntries) do object:Destroy() end
	table.clear(rarityEntries)
	local source = type(state.Rarities) == "table" and state.Rarities or {}
	local options = {}
	for _, entry in ipairs(source) do
		if type(entry) == "table" and type(entry.Id) == "string" then table.insert(options, entry) end
	end
	table.sort(options, function(a, b)
		local aOrder, bOrder = tonumber(a.SortOrder) or 999, tonumber(b.SortOrder) or 999
		if aOrder == bOrder then return a.Id < b.Id end
		return aOrder < bOrder
	end)
	for i, option in ipairs(options) do
		local enabled = selectedRarities[option.Id] == true
		local row = button(rarityList, "", UDim2.new(1, -6, 0, 55), UDim2.fromOffset(0, 0),
			enabled and Color3.fromRGB(39, 91, 86) or colors.surface)
		row.LayoutOrder, row.ZIndex = i, 32
		local tick = textLabel(row, enabled and "✓" or "○", UDim2.fromOffset(34, 40),
			UDim2.fromOffset(13, 7), 21, enabled and colors.green or colors.muted, true)
		tick.ZIndex = 33
		local name = textLabel(row, option.DisplayName or option.Id,
			UDim2.new(1, -69, 0, 44), UDim2.fromOffset(51, 5), 14, colors.text, true)
		name.ZIndex = 33
		table.insert(rarityEntries, row)
		row.Activated:Connect(function()
			selectedRarities[option.Id] = not selectedRarities[option.Id]
			renderRarities(catalog)
			setStatus((option.DisplayName or option.Id) .. (selectedRarities[option.Id] and " selected." or " excluded."), colors.cyan)
		end)
	end
	selectedCount = enabledRarityCount(state)
	rarityButton.Text = string.format("Buy rarities: %d selected  ▾", selectedCount)
	popupDescription.Text = selectedCount .. " selected  •  Only these exact rarities will be purchased."
	if #options == 0 then
		local empty = textLabel(rarityList, "Rarities are still loading. Try again shortly.",
			UDim2.new(1, -10, 0, 45), UDim2.new(), 12, colors.muted)
		empty.ZIndex = 32; table.insert(rarityEntries, empty)
	end
end
