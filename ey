		Position = position or UDim2.fromOffset(0, 0),
		BackgroundColor3 = color or colors.surface,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = colors.text,
		AutoButtonColor = true,
	})
	rounded(object, 10)
	return object
end

