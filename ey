local tollTargets, lastTollScan, lastTollPlot = {}, -math.huge, nil
local function getTollTargets()
	local plot = ownPlot()
	if not plot or plot:GetAttribute("OwnerUserId") ~= player.UserId then
		lastTollPlot = nil
		table.clear(tollTargets)
		return tollTargets, nil
	end
	if plot == lastTollPlot and os.clock() - lastTollScan < 20 then
		return tollTargets, plot
	end
	lastTollPlot = plot
	lastTollScan = os.clock()
	table.clear(tollTargets)
	for _, object in ipairs(plot:GetDescendants()) do
		if object:IsA("Model") and object.Name == "ActiveToll"
			and object:GetAttribute("TollUpgradeRuntime") == true then
			table.insert(tollTargets, object)
		end
	end
	table.sort(tollTargets, function(a, b)
		return (tonumber(a:GetAttribute("LineIndex")) or math.huge)
			< (tonumber(b:GetAttribute("LineIndex")) or math.huge)
	end)
	return tollTargets, plot
end
local tollAttempts = setmetatable({}, {__mode = "k"})
local function tryTollUpgrade()
	local remote = endpoint("TollUpgradeEvent", "RemoteEvent")
	local targets, plot = getTollTargets()
	if not plot then
		setStatus("Waiting for your plot before upgrading tolls.", colors.muted)
		return
	end
	local sent, missingGui, visitedLines, attempted = 0, 0, {}, {}
	for _, toll in ipairs(targets) do
		if not upgradeFlags.Tolls or not alive or ownPlot() ~= plot then break end
		local lineIndex = tonumber(toll:GetAttribute("LineIndex"))
		if lineIndex and lineIndex >= 1 and lineIndex % 1 == 0
			and not visitedLines[lineIndex] and toll:IsDescendantOf(plot)
			and plot:GetAttribute("OwnerUserId") == player.UserId then
			visitedLines[lineIndex] = true
			local lastAttempt = tollAttempts[toll]
			if not lastAttempt or os.clock() - lastAttempt >= 30 then
				local oldLevel = tonumber(toll:GetAttribute("TollLevel"))
				local ok, outcome = pcall(function()
					local guiName = string.format("TollUpgradeGUI_Line_%02d", lineIndex)
					local tollGui = playerGui:FindFirstChild(guiName)
					if not tollGui then
						local part = toll.PrimaryPart or toll:FindFirstChildWhichIsA("BasePart", true)
						if part then moveNear(part, 12) end
						tollGui = playerGui:WaitForChild(guiName, 1)
					end
					if not tollGui then return "missing" end
					-- The GUI can appear during movement, so recheck the plot immediately before firing.
					if ownPlot() ~= plot or plot:GetAttribute("OwnerUserId") ~= player.UserId
						or not toll:IsDescendantOf(plot) or tollGui.Parent ~= playerGui
						or tollGui.Name ~= guiName or not upgradeFlags.Tolls or not alive then return end
					local guiOwner = tollGui:GetAttribute("OwnerUserId")
					if guiOwner ~= nil and tonumber(guiOwner) ~= player.UserId then return end
					if (tollGui:IsA("BillboardGui") or tollGui:IsA("SurfaceGui"))
						and tollGui.Adornee and not tollGui.Adornee:IsDescendantOf(plot) then return end
					tollAttempts[toll] = os.clock()
					remote:FireServer(tollGui)
					return "sent"
				end)
				if ok and outcome == "sent" then
					sent = sent + 1
					table.insert(attempted, {toll = toll, level = oldLevel})
					task.wait(0.35)
				elseif ok and outcome == "missing" then
					missingGui = missingGui + 1
				elseif not ok then
					setStatus("Toll " .. lineIndex .. ": " .. tostring(outcome), colors.red)
				end
			end
		end
	end
	if sent > 0 then
		task.wait(2)
		local confirmed = 0
		for _, entry in ipairs(attempted) do
			local current = tonumber(entry.toll:GetAttribute("TollLevel"))
			if current and entry.level and current > entry.level then
				confirmed = confirmed + 1
			end
		end
		if confirmed > 0 then
			setStatus("Upgraded " .. confirmed .. " of " .. sent .. " toll line(s) on your plot.", colors.green)
		else
			setStatus("Sent " .. sent .. " toll request(s), but no level changed yet. Check cash or game requirements.", colors.muted)
		end
	elseif missingGui > 0 then
		setStatus(missingGui .. " toll GUI(s) unavailable. Visit or open your toll upgrades.", colors.muted)
	end
end

local upgradeOrder = {"Traffic", "Spawn", "Speed", "Areas", "Luck", "Rebirth", "Map", "Tolls"}
local upgradeCooldowns = {Traffic = 4, Spawn = 4, Speed = 4, Areas = 4,
	Luck = 4, Rebirth = 20, Map = 15, Tolls = 30}
task.spawn(function()
	local nextAttempt, cursor = {}, 0
	while alive and gui.Parent do
		cursor = cursor % #upgradeOrder + 1
		local key = upgradeOrder[cursor]
		if upgradeFlags[key] and os.clock() >= (nextAttempt[key] or 0) then
			nextAttempt[key] = os.clock() + upgradeCooldowns[key]
			local ok, result = pcall(function()
				if key == "Traffic" then purchaseLine("LineUpgrade")
				elseif key == "Spawn" then purchaseLine("SpawnIntervalUpgrade")
				elseif key == "Speed" then purchaseLine("CarsSpeedUpgrade")
				elseif key == "Areas" then purchaseRoll("RollStandUpgrade", "Areas")
				elseif key == "Luck" then purchaseRoll("LuckUpgrade", "Luck")
				elseif key == "Rebirth" then tryRebirth()
				elseif key == "Map" then tryMapUnlock()
				elseif key == "Tolls" then tryTollUpgrade() end
			end)
			if not ok then setStatus(key .. " upgrade: " .. tostring(result), colors.red) end
		end
		task.wait(1)
	end
end)
