local function claimIndex()
	local response = endpoint("GlobalCarsIndexClaimRequest", "RemoteFunction"):InvokeServer("ClaimAll")
	assert(type(response) == "table" and response.Success == true,
		type(response) == "table" and (response.Message or response.Error) or "Car index rewards are unavailable.")
	local claimed = response.ClaimedCars
	local count = tonumber(response.Count) or 0
	if type(claimed) == "table" then
		count = 0
		for _ in pairs(claimed) do count = count + 1 end
	end
	return count
end
connect(indexButton.Activated, function()
	autoIndex = not autoIndex
	indexButton.Text = autoIndex and "Auto Claim  ON" or "Auto Claim  OFF"
	indexButton.BackgroundColor3 = autoIndex and Color3.fromRGB(38, 112, 97) or colors.surface
	setStatus(autoIndex and "Car index rewards will be checked every 60 seconds." or "Auto Claim paused.", colors.cyan)
end)
task.spawn(function()
	local nextEquip, nextClaim = 0, 0
	while alive and gui.Parent do
		local now = os.clock()
		if autoEquip and now >= nextEquip then
			nextEquip = now + 20
			local ok, result = pcall(equipBest)
			if not ok then setStatus("Auto Equip: " .. tostring(result), colors.red) end
		end
		if autoIndex and now >= nextClaim then
			nextClaim = now + 60
			local ok, result = pcall(claimIndex)
			if ok and result > 0 then setStatus("Claimed " .. result .. " index rewards.", colors.green)
			elseif not ok then setStatus("Index claim: " .. tostring(result), colors.red) end
		end
		task.wait(1)
	end
end)
