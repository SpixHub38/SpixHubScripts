local function layout()
	local viewport = gui.AbsoluteSize
	if viewport.X < 2 or viewport.Y < 2 then return end

	local width = math.min(
		maximized and 760 or 470,
		math.max(240, viewport.X - 24)
	)
	local height = math.min(
		maximized and 820 or 630,
		math.max(180, viewport.Y - 24)
	)

	if minimized then height = 65 end
	window.Size = UDim2.fromOffset(width, height)
	window.Position = UDim2.fromOffset(
		(viewport.X - width) / 2,
		(viewport.Y - height) / 2
	)

	tabBar.Visible = not minimized
	status.Visible = not minimized
	rollBody.Visible = not minimized and selectedTab == "Auto Roll"
	buyBody.Visible = not minimized and selectedTab == "Auto Buy"
	eventBody.Visible = not minimized and selectedTab == "Event"

	rollTab.BackgroundColor3 =
		selectedTab == "Auto Roll" and colors.green or colors.surface
	buyTab.BackgroundColor3 =
		selectedTab == "Auto Buy" and colors.violet or colors.surface
	eventTab.BackgroundColor3 =
		selectedTab == "Event" and colors.green or colors.surface

	minimize.Text = minimized and "+" or "−"
	maximize.Text = maximized and "□" or "+"
end

