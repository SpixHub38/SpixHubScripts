local function make(kind, properties)
	local item = Instance.new(kind)
	local parent = properties.Parent
	for key, value in pairs(properties) do if key ~= "Parent" then item[key] = value end end
	item.Parent = parent
	return item
end
local function connect(signal, callback)
	local handle = signal:Connect(callback)
	table.insert(connections, handle)
	return handle
end
local function round(item, radius)
	make("UICorner", {CornerRadius = UDim.new(0, radius or 12), Parent = item})
end
