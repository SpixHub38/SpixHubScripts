local function loadCatalog()
	local result = endpoint(
		"GlobalCarsIndexRequest",
		"RemoteFunction"
	):InvokeServer()

	assert(
		type(result) == "table"
			and type(result.Cars) == "table"
			and type(result.Rarities) == "table",
		"Car catalog is unavailable."
	)

	catalog = result
	table.clear(carRarities)

	for _, car in ipairs(result.Cars) do
		if type(car) == "table"
			and type(car.Id) == "string"
			and type(car.RarityId) == "string" then
			carRarities[car.Id] = car.RarityId
		end
	end

	for _, rarity in ipairs(result.Rarities) do
		if type(rarity) == "table"
			and type(rarity.Id) == "string"
			and selectedRarities[rarity.Id] == nil then
			selectedRarities[rarity.Id] = true
		end
	end
end

local raritiesOpen = false

local function renderRarities()
	for _, row in ipairs(rarityRows) do row:Destroy() end
	table.clear(rarityRows)

	if not raritiesOpen or not catalog then return end

	for index, rarity in ipairs(catalog.Rarities) do
		if type(rarity) == "table"
			and type(rarity.Id) == "string" then

			local id = rarity.Id
			local name = rarity.DisplayName or id
			local selected = selectedRarities[id] == true

			local row = button(
				buyBody,
				(selected and "✓  " or "○  ") .. name,
				UDim2.new(1, -5, 0, 48),
				UDim2.fromOffset(0, 0),
				selected and colors.green or colors.surface
			)

			row.LayoutOrder = 10 + index
			table.insert(rarityRows, row)

			row.Activated:Connect(function()
				selectedRarities[id] = not selectedRarities[id]
				renderRarities()
			end)
		end
	end
end

