local function ownPlot()
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return nil end
	for _, plot in ipairs(plots:GetChildren()) do
		if plot:GetAttribute("OwnerUserId") == player.UserId then return plot end
	end
	return nil
end
local function ownLeverPrompt()
	local plot = ownPlot()
	local stands = plot and plot:FindFirstChild("RollStands")
	local lever = stands and stands:FindFirstChild("Lever")
	for _, child in ipairs(lever and lever:GetDescendants() or {}) do
		if child:IsA("ProximityPrompt") and child.Parent and child.Parent:IsA("BasePart") then
			return child
		end
	end
	return nil
end
connect(instantButton.Activated, function()
	perform(function()
		local prompt = ownLeverPrompt()
		assert(prompt and prompt:IsDescendantOf(workspace), "Your roll stand is not ready yet.")
		assert(prompt.Enabled, "Your roll lever is currently unavailable. Wait until it is ready.")
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local promptPart = prompt.Parent
		assert(root and promptPart and promptPart:IsA("BasePart"), "Your roll lever is not loaded.")
		assert((root.Position - promptPart.Position).Magnitude <= prompt.MaxActivationDistance,
			"Move closer to your roll lever to roll.")
		setStatus("Rolling at your stand...", colors.cyan)
		prompt:InputHoldBegin()
		task.wait(math.max(0, prompt.HoldDuration) + 0.12)
		prompt:InputHoldEnd()
		return "Roll interaction sent. Your stand controls the result and cooldown."
	end)
end)

local function buyNextCar()
	if not catalog or enabledRarityCount(catalog) == 0 then return end
	local plot = ownPlot()
	assert(plot, "Waiting for your plot to load before buying cars.")
	local stands = plot:FindFirstChild("RollStands")
	if not stands then return end
	for _, stand in ipairs(stands:GetChildren()) do
		if not autoBuy or not alive then return end
		if stand:IsA("Model") and stand.Name:match("^Stand_") then
			local prompt = stand:FindFirstChild("ClaimPrompt", true)
			local carId = stand:GetAttribute("RolledCarId")
			if not carId and prompt then carId = prompt:GetAttribute("CarId") end
			local rarityId = carRarities[carId] or stand:GetAttribute("RarityId")
			local previous = buyAttempts[stand]
			if rarityId and selectedRarities[rarityId] and prompt and prompt:IsA("ProximityPrompt")
				and prompt.Enabled and prompt.ActionText == "BUY CAR"
				and (not previous or previous.carId ~= carId or os.clock() - previous.at > 25) then
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				assert(root and humanoid and humanoid.Health > 0, "Waiting for your character to respawn.")
				assert(not humanoid.Sit, "Leave your vehicle before Auto Buy moves to a stand.")
				local holder = prompt.Parent
				local part = holder and (holder:IsA("BasePart") and holder
					or holder:IsA("Attachment") and holder.Parent)
				assert(part and part:IsA("BasePart"), "The car's BUY CAR prompt has no stand part.")
				local near = part.Position + Vector3.new(0, part.Size.Y / 2 + 3, 0)
					+ part.CFrame.LookVector * 4
				local destination = CFrame.new(near, Vector3.new(part.Position.X, near.Y, part.Position.Z))
				local distance = (root.Position - part.Position).Magnitude
				if distance > prompt.MaxActivationDistance - 1 then
					if distance > 65 then
						root.CFrame = destination
					else
						local tween = TweenService:Create(root,
							TweenInfo.new(math.clamp(distance / 38, 0.3, 1.8), Enum.EasingStyle.Linear),
							{CFrame = destination})
						tween:Play()
						tween.Completed:Wait()
					end
				end
				task.wait(0.25)
				if not autoBuy or not alive or player.Character ~= character or not prompt.Enabled then return end
				assert((root.Position - part.Position).Magnitude <= prompt.MaxActivationDistance,
					"Could not reach " .. tostring(prompt.ObjectText) .. ". Move to your plot and try again.")
				buyAttempts[stand] = {carId = carId, at = os.clock()}
				prompt:InputHoldBegin()
				task.wait(math.max(0, prompt.HoldDuration) + 0.15)
				prompt:InputHoldEnd()
				setStatus("BUY CAR sent for " .. tostring(prompt.ObjectText)
					.. ". The game checks your cash and stand ownership.", colors.green)
				task.wait(0.5)
				return
			end
		end
	end
end
task.spawn(function()
	local nextCatalog = 0
	while alive and gui.Parent do
		if not catalog and os.clock() >= nextCatalog then
			nextCatalog = os.clock() + 15
			local ok, result = pcall(refreshCatalog)
			if ok then
				selectedCount = enabledRarityCount(result)
				rarityButton.Text = string.format("Buy rarities: %d selected  ▾", selectedCount)
				if rarityPopup.Visible then renderRarities(result) end
			elseif autoBuy then
				setStatus("Car catalog: " .. tostring(result), colors.red)
			end
		end
		if autoBuy and catalog then
			local ok, result = pcall(buyNextCar)
			if not ok then setStatus("Auto Buy: " .. tostring(result), colors.red) end
		end
		task.wait(1.5)
	end
end)

