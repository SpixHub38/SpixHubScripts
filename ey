local minimized, maximized, dragged = false, false, false
local savedPosition = UDim2.fromOffset(100, 80)
local function layout()
	local viewport = bounds.AbsoluteSize
	if viewport.X < 2 or viewport.Y < 2 then return end
	local width = math.min(maximized and 760 or 470, math.max(240, viewport.X - 24))
	local height = math.min(maximized and 820 or 635, math.max(180, viewport.Y - 24))
	if minimized then height = 64 end
	window.Size = UDim2.fromOffset(width, height)
	headingTitle.Text = width < 390 and "KAI" or "KAI / GARAGE"
	headingSubtitle.Visible = width >= 390
	if not dragged or maximized and not minimized then
		window.Position = UDim2.fromOffset((viewport.X - width) / 2, (viewport.Y - height) / 2)
	else
		window.Position = UDim2.fromOffset(
			math.clamp(savedPosition.X.Offset, 0, math.max(0, viewport.X - width)),
			math.clamp(savedPosition.Y.Offset, 0, math.max(0, viewport.Y - height)))
	end
	tabs.Visible = not minimized
	status.Visible = not minimized
	rollBody.Visible = not minimized and selectedTab == "Auto Roll"
	buyBody.Visible = not minimized and selectedTab == "Auto Buy"
	if minimized then rarityPopup.Visible = false end
	rollTab.BackgroundColor3 = selectedTab == "Auto Roll" and Color3.fromRGB(42, 112, 126) or colors.surface
	buyTab.BackgroundColor3 = selectedTab == "Auto Buy" and Color3.fromRGB(78, 66, 132) or colors.surface
	minimize.Text = minimized and "+" or "−"
	maximize.Text = maximized and "□" or "+"
end
