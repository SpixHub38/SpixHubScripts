local function canAfford(price)
	local money = player:FindFirstChild("Money")
	local balance = money and tonumber(money.Value)
	return balance ~= nil and tonumber(price) ~= nil and balance >= tonumber(price)
end

local function standOnUpgradeBoard()
	local plot = ownPlot()
	assert(plot and plot:GetAttribute("OwnerUserId") == player.UserId,
		"Waiting for your owned plot before upgrading.")
	local board = plot:FindFirstChild("UpgradeBoard", true)
	local pad = board and board:FindFirstChild("Part")
	assert(pad and pad:IsA("BasePart") and pad:IsDescendantOf(plot),
		"Your plot's upgrade pad has not loaded.")
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	assert(root and humanoid and humanoid.Health > 0, "Waiting for your character to respawn.")
	assert(not humanoid.Sit, "Leave your vehicle before upgrading.")
	local function standingOnPad()
		local offset = pad.CFrame:PointToObjectSpace(root.Position)
		return math.abs(offset.X) <= pad.Size.X / 2 + 0.5
			and math.abs(offset.Z) <= pad.Size.Z / 2 + 0.5
			and offset.Y >= pad.Size.Y / 2
			and offset.Y <= pad.Size.Y / 2 + 7
	end
	if not standingOnPad() then
		local center = pad.CFrame:PointToWorldSpace(Vector3.new(0,
			pad.Size.Y / 2 + humanoid.HipHeight + root.Size.Y / 2 + 0.2, 0))
		root.CFrame = CFrame.new(center, center + pad.CFrame.LookVector)
		task.wait(0.5)
	end
	assert(player.Character == character and ownPlot() == plot
		and plot:GetAttribute("OwnerUserId") == player.UserId
		and pad:IsDescendantOf(plot) and standingOnPad(),
		"Could not stand on your plot's upgrade pad.")
end

local function purchaseLine(id)
	local remote = endpoint("LineUpgradeRequest", "RemoteFunction")
	standOnUpgradeBoard()
	-- The upgrade board sends the selected quantity for both state and purchase.
	-- Without the quantity, the server cannot price or validate these upgrades.
	local state = remote:InvokeServer("GetState", id, 1)
	if type(state) ~= "table" or state.Ready ~= true or state.IsMaxed
		or not canAfford(state.Price) then return end
	-- Another enabled feature may have moved the character while GetState yielded.
	standOnUpgradeBoard()
	local result = remote:InvokeServer("Purchase", id, 1)
	assert(result ~= false and (type(result) ~= "table"
		or result.Ready ~= false and result.Success ~= false),
		"The game's " .. id .. " upgrade was rejected.")
	setStatus(id .. " upgrade requested. The server checks the purchase.", colors.green)
end

local function purchaseRoll(id, stateKey)
	local remote = endpoint("RollUpgradeRequest", "RemoteFunction")
	local snapshot = remote:InvokeServer("GetState")
	local entry = type(snapshot) == "table" and snapshot[stateKey]
	if type(snapshot) ~= "table" or snapshot.Ready ~= true
		or type(entry) ~= "table" or entry.IsMaxed then return end
	-- The native upgrade button sends this request without a local balance check.
	-- Let the server validate the price; a client-side check can block valid purchases.
	local result = remote:InvokeServer("Purchase", id)
	assert(result ~= false and (type(result) ~= "table"
		or result.Ready ~= false and result.Success ~= false),
		"The game's " .. stateKey .. " upgrade was rejected.")
	setStatus(stateKey .. " upgrade requested. The server checks the purchase.", colors.green)
end

local function tryRebirth()
	local money = player:FindFirstChild("Money")
	local rebirths = player:FindFirstChild("Rebirths")
	local mapLevel = player:FindFirstChild("MapLevel")
	if not (money and rebirths and mapLevel) then return end
	local definitionsFolder = RS:FindFirstChild("Modules")
	local definitionsModule = definitionsFolder and definitionsFolder:FindFirstChild("RebirthDefinitions")
	if not definitionsModule then return end
	local definitions = require(definitionsModule)
	local current = math.max(0, math.floor(tonumber(rebirths.Value) or 0))
	local cap = definitions:GetMapLevelCap(tonumber(mapLevel.Value) or 1)
	local nextLevel = definitions:GetNextLevel(current)
	if current >= cap or type(nextLevel) ~= "table"
		or not canAfford(nextLevel.RequiredMoney) then return end
	endpoint("RebirthEvent", "RemoteEvent"):FireServer("Rebirth")
	setStatus("Rebirth requested. The game checks money and map requirements.", colors.green)
end

