local function clearStockRows()
	for _, row in ipairs(stockRows) do row:Destroy() end
	table.clear(stockRows)
end

local function refreshShop()
	local result = endpoint(
		"GemShopRequest",
		"RemoteFunction"
	):InvokeServer("GetState")

	assert(
		type(result) == "table"
			and result.Success ~= false
			and type(result.Offers) == "table",
		"Gem shop stock is unavailable."
	)

	shopState = result
	clearStockRows()

	for index, offer in ipairs(result.Offers) do
		if type(offer) == "table" then
			local name = tostring(
				offer.DisplayName or offer.Id or "Offer"
			)

			local stock
			if offer.UsesStock then
				stock = string.format(
					"%d / %d in stock",
					tonumber(offer.Stock) or 0,
					tonumber(offer.MaxStock) or 0
				)
			else
				stock = "No stock limit"
			end

			local row = make("Frame", {
				Parent = eventBody,
				LayoutOrder = 10 + index,
				Size = UDim2.new(1, -5, 0, 65),
				BackgroundColor3 = colors.panel,
				BorderSizePixel = 0,
			})
			rounded(row, 10)

			label(
				row,
				name,
				UDim2.new(1, -24, 0, 27),
				UDim2.fromOffset(12, 5),
				colors.text,
				14
			)

			label(
				row,
				stock,
				UDim2.new(1, -24, 0, 25),
				UDim2.fromOffset(12, 34),
				colors.cyan,
				12
			)

			table.insert(stockRows, row)
		end
	end

	if #stockRows == 0 then
		setStatus("The gem shop has no current offers.", colors.muted)
	end
end

