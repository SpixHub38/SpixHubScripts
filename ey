local dragInput, dragStart, dragOrigin
connect(heading.InputBegan, function(input)
	if maximized and not minimized then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if input.Position.X > heading.AbsolutePosition.X + heading.AbsoluteSize.X - 152 then return end
		dragInput, dragStart, dragOrigin = input, input.Position, window.Position
	end
end)
connect(UIS.InputChanged, function(input)
	if not dragInput then return end
	if input ~= dragInput and not (dragInput.UserInputType == Enum.UserInputType.MouseButton1
		and input.UserInputType == Enum.UserInputType.MouseMovement) then return end
	local d = input.Position - dragStart
	dragged = true
	savedPosition = UDim2.fromOffset(dragOrigin.X.Offset + d.X, dragOrigin.Y.Offset + d.Y)
	layout()
end)
connect(UIS.InputEnded, function(input)
	if input == dragInput then dragInput, dragStart, dragOrigin = nil, nil, nil end
end)
connect(UIS.InputBegan, function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.RightShift and not UIS:GetFocusedTextBox() then
		show(not window.Visible)
	end
end)
