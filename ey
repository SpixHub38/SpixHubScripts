task.spawn(function()
	local nextCatalog = 0
	local nextBuy = 0
	local nextEquip = 0
	local nextClaim = 0
	local nextShop = 0

	while alive and gui.Parent do
		local now = os.clock()

		if not catalog and now >= nextCatalog then
			nextCatalog = now + 15
			local ok, err = pcall(loadCatalog)
			if ok then
				renderRarities()
			elseif autoBuy then
				setStatus("Catalog: " .. tostring(err), colors.red)
			end
		end

		if autoRoll and now - lastRoll >= 2.5 then
			local prompt = rollPrompt()

			if prompt and prompt.Enabled then
				lastRoll = now

				local ok, err = pcall(function()
					usePrompt(prompt, function()
						return autoRoll and alive
					end)
				end)

				if not ok then
					setStatus("Roll: " .. tostring(err), colors.red)
				end
			end
		end

		if autoBuy and catalog and now >= nextBuy then
			nextBuy = now + 1.5

			local ok, err = pcall(buyNextCar)
			if not ok then
				setStatus("Auto Buy: " .. tostring(err), colors.red)
			end
		end

		if (autoEquip or autoReplace) and now >= nextEquip then
			nextEquip = now + 20

			local ok, err = pcall(equipBest)
			if not ok then
				setStatus("Equip Best: " .. tostring(err), colors.red)
			end
		end

		if autoClaim and now >= nextClaim then
			nextClaim = now + 60

			local ok, err = pcall(claimIndex)
			if not ok then
				setStatus("Car Index: " .. tostring(err), colors.red)
			end
		end

		if selectedTab == "Event" and now >= nextShop then
			nextShop = now + 10

			local ok, err = pcall(refreshShop)
			if not ok then
				setStatus("Gem shop: " .. tostring(err), colors.red)
			end
		end

		if shopState and tonumber(shopState.ResetAt) then
			local remaining = math.max(
				0,
				math.floor(shopState.ResetAt - os.time())
			)

			resetLabel.Text = string.format(
				"Shop Reset in %02d:%02d",
				math.floor(remaining / 60),
				remaining % 60
			)

			if remaining == 0 then
				nextShop = 0
			end
		end

		task.wait(1)
	end
end)
