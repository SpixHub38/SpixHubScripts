local function ownPlot()
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return nil end
	for _, plot in ipairs(plots:GetChildren()) do
		if plot:GetAttribute("OwnerUserId") == player.UserId then return plot end
	end
	return nil
end
local function ownLeverPrompt()
	local plot = ownPlot()
	local stands = plot and plot:FindFirstChild("RollStands")
	local lever = stands and stands:FindFirstChild("Lever")
	for _, child in ipairs(lever and lever:GetDescendants() or {}) do
		if child:IsA("ProximityPrompt") and child.Parent and child.Parent:IsA("BasePart") then
			return child
		end
	end
	return nil
end
local function moveNear(part, range)
	assert(part and part:IsA("BasePart"), "The destination has not loaded.")
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	assert(root and humanoid and humanoid.Health > 0, "Waiting for your character to respawn.")
	assert(not humanoid.Sit, "Leave your vehicle before moving to your plot.")
	local distance = (root.Position - part.Position).Magnitude
	if distance > range - 1 then
		local lift = math.clamp(part.Size.Y / 2 + 2.5, 2.5, 4)
		local near = part.Position + part.CFrame.LookVector * 4 + Vector3.new(0, lift, 0)
		local destination = CFrame.new(near, Vector3.new(part.Position.X, near.Y, part.Position.Z))
		if distance > 65 then
			root.CFrame = destination
		else
			local tween = TweenService:Create(root,
				TweenInfo.new(math.clamp(distance / 38, 0.3, 1.8), Enum.EasingStyle.Linear),
				{CFrame = destination})
			tween:Play()
			tween.Completed:Wait()
		end
		task.wait(0.25)
	end
	assert(player.Character == character and (root.Position - part.Position).Magnitude <= range,
		"Could not reach the interaction point.")
end
local function usePrompt(prompt, active)
	assert(prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled,
		"This interaction is currently unavailable.")
	local holder = prompt.Parent
	local part = holder and (holder:IsA("Attachment") and holder.Parent or holder)
	moveNear(part, prompt.MaxActivationDistance)
	if active and not active() or not prompt.Enabled or not prompt:IsDescendantOf(workspace) then return false end
	prompt:InputHoldBegin()
	task.wait(math.max(0, prompt.HoldDuration) + 0.15)
	prompt:InputHoldEnd()
	return true
end
