        status(key, 'Arriving'); return false
    end
    if not current or current.owner ~= key or (current.goal - destination).Magnitude > 8 or current.character ~= player.Character
        or current.mode ~= travelMode then
        cancelMotion()
        local leg = hub.config.NoClip and destination or routeLeg(player.Character, humanoid, root, destination)
        if not leg then status(key, 'Waiting for the next route section to load'); return false end
        current = {owner = key, goal = destination, priority = priority, touched = clock(), started = clock(),
            character = player.Character, position = root.Position, progressAt = clock(), nodes = {}, index = 1, planning = true,
            leg = leg, mode = travelMode, reach = reach}
        hub.motion = current
        humanoid.Sit = false
        if hub.config.NoClip then current.nodes = {destination}; current.planning = false
        else
            task.spawn(function()
                local ok, nodes = pcall(function()
                    local path = Pathfinding:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 5})
                    path:ComputeAsync(root.Position, current.leg)
                    if path.Status ~= Enum.PathStatus.Success then error('No walking route found') end
                    return path:GetWaypoints()
                end)
