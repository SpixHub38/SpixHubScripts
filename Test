        hub.motionFailures[key] = {goal = current.goal, at = clock(), reason = 'No walking route found'}
        hub.lastTravelError = key .. ': No walking route found'
        cancelMotion(key); hub.workers[key].next = clock() + 2; return false
    end
    if current.planning then
        status(key, 'Finding a route')
        if clock() - current.started > 10 then
            hub.motionFailures[key] = {goal = current.goal, at = clock(), reason = 'Route planning timed out'}
            hub.lastTravelError = key .. ': Route planning timed out'
            cancelMotion(key); status(key, 'Route timed out; retrying')
        end
    else status(key, 'Travelling') end
    return false
end
local function moveStep(dt)
    local motion = hub.motion
    if not motion then return end
    local _, humanoid, root = body()
    if not root or motion.character ~= player.Character or not hub.config[motion.owner] then cancelMotion(); return end
    if clock() - motion.touched > 2 or hub.config.Fly then cancelMotion(); return end
    if motion.planning or motion.failed then return end
    if motion.leg and (motion.leg - motion.goal).Magnitude > 2
        and Vector3.new(root.Position.X - motion.leg.X, 0, root.Position.Z - motion.leg.Z).Magnitude < 3
        and math.abs(root.Position.Y - motion.leg.Y) < 7 then
        cancelMotion(motion.owner); hub.workers[motion.owner].next = 0
        status(motion.owner, 'Continuing to the next route section'); return
    end
    local node = motion.nodes[motion.index]
    if not node then node = motion.leg or motion.goal end
    local position = typeof(node) == 'Vector3' and node or node.Position
    if (root.Position - motion.goal).Magnitude <= (motion.reach or 2) then
        cancelMotion(); hub.workers[motion.owner].next = 0; return
    end
    local delta = position - root.Position
    if (motion.mode or hub.config.Travel) == 'Walk' then
        if typeof(node) ~= 'Vector3' then position = position + Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2, 0) end
        delta = position - root.Position
        if typeof(node) ~= 'Vector3' and node.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
        local flat = Vector3.new(delta.X, 0, delta.Z)
        if flat.Magnitude < 2.5 and math.abs(delta.Y) < 7 then motion.index = motion.index + 1 end
        motion.walkGoal = position
        humanoid:MoveTo(position)
    else
        local remaining = tweenSpeed(motion.owner) * math.min(math.max(dt, 0), 0.1)
        for _ = 1, 64 do
            local waypoint = motion.nodes[motion.index]
            local endpoint = waypoint or motion.leg or motion.goal
            local destination = typeof(endpoint) == 'Vector3' and endpoint or endpoint.Position
            if typeof(endpoint) ~= 'Vector3' then destination = destination + Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2, 0) end
            local offset = destination - root.Position
            if offset.Magnitude <= 0.05 then
                if not waypoint then break end
                motion.index = motion.index + 1
            elseif remaining <= 0 then break
            else
                local step = math.min(offset.Magnitude, remaining)
                root.CFrame = CFrame.new(root.Position + offset.Unit * step) * root.CFrame.Rotation
                remaining = remaining - step
                if step >= offset.Magnitude then
                    if not waypoint then break end
                    motion.index = motion.index + 1
                else break end
            end
        end
        root.AssemblyLinearVelocity = Vector3.zero
        humanoid:MoveTo(root.Position); humanoid:Move(Vector3.zero)
        if (root.Position - (motion.leg or motion.goal)).Magnitude <= 0.1 then
            if motion.leg and (motion.leg - motion.goal).Magnitude > 2 then cancelMotion(motion.owner) end
            hub.workers[motion.owner].next = 0
        end
    end
    if (root.Position - motion.position).Magnitude > 1 then motion.position = root.Position; motion.progressAt = clock() end
    if clock() - motion.progressAt > 3 then
        hub.motionFailures[motion.owner] = {goal = motion.goal, at = clock(), reason = 'Movement made no progress'}
        hub.lastTravelError = motion.owner .. ': Movement made no progress'
        cancelMotion(); status(motion.owner, 'Movement stalled; retrying route')
    end
end
