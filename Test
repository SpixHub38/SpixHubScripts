local function request(key, folder, name, args, callback)
    local id = folder .. '/' .. name
    if hub.pending[id] then status(key, 'Waiting for the previous server request'); return false end
    local event = remote(folder, name, 'RemoteFunction')
    if not event then status(key, 'Waiting for ' .. name .. ' to load'); return false end
    local pending = {key = key, at = clock()}
    hub.pending[id] = pending
    task.spawn(function()
        local result = table.pack(pcall(event.InvokeServer, event, table.unpack(args or {})))
        if hub.pending[id] == pending then hub.pending[id] = nil end
        if not hub.alive then return end
        if not result[1] then
            status(key, 'Server error: ' .. tostring(result[2]):sub(1, 100))
            hub.errors[key] = tostring(result[2]); hub.workers[key].next = clock() + 3
            if hub.spending and hub.spending.key == key then hub.spending = nil end
            return
        end
        hub.errors[key] = nil
        local ok, err = pcall(callback, table.unpack(result, 2, result.n))
        if not ok then hub.errors[key] = tostring(err); status(key, 'Retrying: ' .. tostring(err):sub(1, 100)) end
    end)
    return true
end
local function fire(key, folder, name, ...)
