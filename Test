    if owner ~= 'AutoSteal' then return speed end
    if clock() >= (hub.guardSpeedAt or 0) then
        local zoneSpeed, observed = 0, 0
        for _, zone in ipairs(children(workspace:FindFirstChild('Zones'))) do
            zoneSpeed = math.max(zoneSpeed, Core.number(attr(zone, 'GuardianSpeed')) or 0)
        end
        for _, guardian in ipairs(children(workspace:FindFirstChild('ActiveGuardians'))) do
            if guardian:IsA('Model') and attr(guardian, 'IsGuardian') == true then
                local humanoid = guardian:FindFirstChildOfClass('Humanoid')
                if humanoid and humanoid.Health > 0 then
                    observed = math.max(observed, Core.number(humanoid.WalkSpeed) or 0)
                    local root = guardian:FindFirstChild('HumanoidRootPart')
                    if root and root:IsA('BasePart') then
                        local velocity = root.AssemblyLinearVelocity
                        observed = math.max(observed, Core.number(Vector3.new(velocity.X, 0, velocity.Z).Magnitude) or 0)
                    end
                end
            end
        end
        local config = RS:FindFirstChild('GuardConfig')
        local catchUp = Core.clamp(attr(config, 'CatchUpMax', 1), 1, 10)
        local rush = Core.clamp(attr(config, 'RushBoost', 1), 1, 5)
        hub.guardSpeedFloor = math.min(6000, math.max(600, zoneSpeed * catchUp * rush * 1.35 + 75, observed * 1.5 + 75))
        hub.guardSpeedAt = clock() + 0.25
    end
    speed = math.max(speed, hub.guardSpeedFloor or 600)
    hub.effectiveStealSpeed = speed
    return speed
end
local function travel(key, destination, reach, priority, teleport, mode)
