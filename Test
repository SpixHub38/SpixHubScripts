    local old = hub.movementDefaults
    if not old or old.humanoid ~= humanoid then
        old = {humanoid = humanoid, speed = humanoid.WalkSpeed, jump = humanoid.JumpPower, height = humanoid.JumpHeight}
        hub.movementDefaults = old
    end
    if hub.config.SpeedEnabled then humanoid.WalkSpeed = hub.config.WalkSpeed
    elseif hub.speedApplied then humanoid.WalkSpeed = old.speed end
    hub.speedApplied = hub.config.SpeedEnabled
    if hub.config.JumpEnabled then
        if humanoid.UseJumpPower then humanoid.JumpPower = hub.config.JumpPower
        else humanoid.JumpHeight = hub.config.JumpPower ^ 2 / (2 * workspace.Gravity) end
    elseif hub.jumpApplied then humanoid.JumpPower = old.jump; humanoid.JumpHeight = old.height end
