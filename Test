local lastBind = -10
connect(RunService.Heartbeat, function(dt)
    if not hub.alive then return end
    local ok, err = pcall(function()
        playerStep(); moveStep(dt)
        if attr(player, 'BossLoopFight') ~= nil then hub.wasInFight = true end
        if clock() - lastBind > 2 then bindNativeEvents(); lastBind = clock() end
        local hold = hub.hold
        if hold then
            local _, _, root = body()
            local pos = hold.prompt.Parent and promptPosition(hold.prompt)
            local confirmed = attr(player.Character, 'CarryingEgg') == true or hub.claimCounter > hold.claimBefore
            local interrupted = not hub.config.AutoSteal or not root or not pos
                or (root.Position - pos).Magnitude > hold.prompt.MaxActivationDistance
                or hub.stealRevision ~= hold.revision
                or not hold.triggered and not matchesEggFilter(hold.target)
            if confirmed or interrupted then
                releaseHold()
                hub.promptCooldown[hold.prompt] = clock() + 1
                hub.hold = nil; hub.stealTarget = nil
                if confirmed then
                    hub.stealStats.confirmed = hub.stealStats.confirmed + 1
                    hub.stealCycle = nil
                    local trip = hold.trip or hub.stealTrip or beginTrip(hold.target, 'return')
                    hub.stealTrip = trip; trip.claimBefore = hold.claimBefore
                    tripStage(trip, 'return')
                    hub.workers.AutoSteal.next = 0
                    status('AutoSteal', 'Egg taken; returning to the claim area')
                else status('AutoSteal', 'Egg interaction interrupted; retrying') end
            elseif clock() >= hold.ends then
                if hold.triggered and hold.phase ~= 'confirm' then
                    hold.phase = 'confirm'; hold.ends = clock() + 3
                    status('AutoSteal', 'Waiting for the game to confirm the egg')
                elseif hold.phase == 'hold' then
                    hold.phase = 'grace'; hold.ends = clock() + 0.6
                elseif hold.phase == 'grace' then
                    local direct = environment.fireproximityprompt or fireproximityprompt
                    if type(direct) == 'function' and not hold.directSent and hold.prompt.Enabled then
                        hold.directSent = true; hold.phase = 'confirm'; hold.ends = clock() + math.max(3, hold.duration + 1)
                        hub.stealStats.direct = hub.stealStats.direct + 1
                        status('AutoSteal', 'Retrying the prompt with direct input')
                        hold.thread = task.spawn(function()
                            if not hub.alive or hub.hold ~= hold or not hub.config.AutoSteal then return end
                            local current = promptPosition(hold.prompt)
                            local _, _, currentRoot = body()
                            if not current or not currentRoot or not hold.prompt.Enabled
                                or (currentRoot.Position - current).Magnitude > hold.prompt.MaxActivationDistance
                                or hub.stealRevision ~= hold.revision or not validStealTarget(hold.target) then return end
                            local success, reason = pcall(direct, hold.prompt)
                            if not success and hub.hold == hold then
                                status('AutoSteal', 'Checking whether the prompt was accepted: ' .. tostring(reason):sub(1, 80))
                            end
                        end)
                    else
                        releaseHold(); hub.stealTarget = nil
                        hub.promptCooldown[hold.prompt] = clock() + 5
                        hub.stealStats.timeouts = hub.stealStats.timeouts + 1
                        hub.stealCycle = nil
                        status('AutoSteal', 'Prompt did not respond; trying another egg')
                    end
                else
                    releaseHold(); hub.stealTarget = nil
                    hub.promptCooldown[hold.prompt] = clock() + 5
                    hub.stealStats.timeouts = hub.stealStats.timeouts + 1
                    hub.stealCycle = nil
                    status('AutoSteal', 'Egg was not confirmed; trying another egg')
                end
            end
        end
        local spending = hub.spending
        if spending and spending.responded then
            local acknowledged = false
            if spending.ack then local success, value = pcall(spending.ack); acknowledged = success and value == true end
            local cash = money()
            if acknowledged or (cash and spending.cash and cash < spending.cash) or clock() - spending.at > 5 then hub.spending = nil end
        end
        for _, requestRecord in pairs(hub.pending) do
            if clock() - requestRecord.at > 12 then status(requestRecord.key, 'Server is taking longer; waiting without sending duplicates') end
        end
        if hub.equipTrail and hub.config.AutoTraits and not hub.spending then
            local rarity = hub.equipTrail
            hub.equipTrail = nil
            request('AutoTraits', 'TrailSystem', 'ToggleTrailEquip', {rarity}, function(value)
                if type(value) == 'table' then hub.trailState = value; hub.trailStateAt = clock() end
            end)
        end
        for key, worker in pairs(hub.workers) do
            if hub.config[key] and not worker.busy and clock() >= worker.next then
                worker.next = clock() + worker.interval; worker.busy = true
                task.spawn(function()
                    if not hub.alive or not hub.config[key] then worker.busy = false; return end
                    local success, reason = xpcall(worker.run, debug.traceback)
                    worker.busy = false
                    if not success then hub.errors[key] = tostring(reason); status(key, 'Retrying: ' .. tostring(reason):sub(1, 110)); worker.next = clock() + 3 end
                end)
            end
        end
    end)
    if not ok then hub.errors.Runtime = tostring(err); status('Runtime', 'Retrying: ' .. tostring(err):sub(1, 110)) end
end)
