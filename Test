    if hub.hold and key ~= 'AutoSteal' then status(key, 'Waiting for the egg interaction'); return false end
    if key ~= 'AutoSteal' and key ~= 'AutoBoss' and hub.config.AutoSteal and hub.stealTrip
        and hub.stealTrip.stage ~= 'select' and attr(player, 'BossLoopFight') == nil then
        status(key, 'Waiting for the current egg trip'); return false
    end
    local current = hub.motion
    if current and current.owner ~= key and current.priority >= priority and clock() - current.touched < 2 then
        status(key, 'Waiting for the current trip'); return false
    end
    local gap = (root.Position - destination).Magnitude
    if gap <= reach then
        if current and current.owner ~= key then cancelMotion() else cancelMotion(key) end
        return true
    end
