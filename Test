local function bossPosition(snapshot, arena)
    local now = workspace:GetServerTimeNow()
    local origin = Vector3.new(snapshot.CX, snapshot.FloorY, snapshot.CZ)
    local moves = moduleAt('GlitchBossMoves')
    local encoded = attr(arena, 'Body')
    if moves and moves.bodyAt and type(encoded) == 'string' and encoded ~= '' then
        if hub.bossBodyEncoded ~= encoded or hub.bossBodyArena ~= arena then
            hub.bossBodyEncoded, hub.bossBodyArena = encoded, arena
            local ok, bodyPlan = pcall(HttpService.JSONDecode, HttpService, encoded)
            hub.bossBody = ok and type(bodyPlan) == 'table' and bodyPlan or nil
        end
        if hub.bossBody then
            local ok, mode, x, y, z = pcall(moves.bodyAt, hub.bossBody, now, snapshot)
            if ok and mode and x and y and z then
                if mode == 'rim' then return nil end
                return origin + Vector3.new(x, y, z)
            end
        end
    end
    if (Core.number(snapshot.ArenaVersion) or 1) >= 2 then return nil end
    local patterns = moduleAt('GlitchBossPatterns')
    if patterns and patterns.perch then
        local chosen, newest, perch, perchTime = nil, -math.huge, 'H', -math.huge
        for id, record in pairs(hub.attacks) do
            local attack = record.value
            if attack and attack.endsAt and attack.endsAt + 1 < now then hub.attacks[id] = nil
            elseif attack then
                if attack.t0 <= now and attack.t0 > perchTime then perch, perchTime = attack.perch or 'H', attack.t0 end
                local ok, state, x, y, z = pcall(attack.bossPoseAt, attack, now)
                if ok and state and x and y and z and attack.t0 > newest then chosen = Vector3.new(x, y, z); newest = attack.t0 end
            end
        end
        if chosen then return origin + chosen end
        local ok, x, y, z = pcall(patterns.perch, perch, snapshot)
        if ok and x and y and z then return origin + Vector3.new(x, y, z) end
    end
    local model = find(workspace, 'GlitchArenaLocal', 'Boss') or arena:FindFirstChild('Boss')
    local root = part(model)
    return root and root.Position
end
