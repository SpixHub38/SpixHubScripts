local Core = {}
function Core.number(value)
    local n = tonumber(value)
    if n and n == n and math.abs(n) < math.huge then return n end
end
function Core.affordable(cash, price, reserve)
    cash, price = Core.number(cash), Core.number(price)
    return cash ~= nil and price ~= nil and price >= 0 and cash - math.max(Core.number(reserve) or 0, 0) >= price
end
function Core.accepted(value, detail)
    if value == true then return true, detail end
    if type(value) == 'table' then return value.ok == true, value.err or value.message end
    return false, type(detail) == 'string' and detail or 'The game did not accept the action'
end
function Core.best(pets, capacity)
    local valid, seen = {}, {}
    for _, pet in ipairs(pets) do
        if type(pet.uid) == 'string' and pet.uid ~= '' and not seen[pet.uid] then
            seen[pet.uid] = true
            local rate = Core.number(pet.rate)
            if rate == nil then return nil, 'Waiting for pet income data' end
            valid[#valid + 1] = {uid = pet.uid, rate = rate, placed = pet.placed == true}
        end
    end
    table.sort(valid, function(a, b)
        if a.rate ~= b.rate then return a.rate > b.rate end
        if a.placed ~= b.placed then return a.placed end
        return a.uid < b.uid
    end)
    local keep = {}
    for i = 1, math.min(#valid, math.max(math.floor(capacity or 0), 1)) do keep[valid[i].uid] = true end
    return keep, valid
end
function Core.sellable(rows, keep, known, locked)
    if not keep then return {} end
    local ids, seen = {}, {}
    for _, row in ipairs(rows) do
        if type(row) == 'table' and row.kind == 'Pet' and type(row.uid) == 'string' and row.uid ~= ''
            and known[row.uid] and not keep[row.uid] and not locked[row.uid] and not seen[row.uid] then
            seen[row.uid] = true
            ids[#ids + 1] = row.uid
            if #ids == 200 then break end
        end
    end
    return ids
end
function Core.rift(state, now)
    if state.disabled then return false, 'Rift is disabled' end
    if state.downed then return false, 'Waiting for the arena to revive you' end
    if state.fighting then return false, 'Already in the arena' end
    if not state.gate then return false, 'Waiting for the portal to spawn' end
    if state.state ~= 'open' and state.state ~= 'live' then return false, 'Waiting for the rift to open' end
    if state.state == 'live' and not state.late then return false, 'Late entry is closed' end
    if state.untilAt and now >= state.untilAt then return false, 'Portal entry has closed' end
    if state.full then return false, 'Rift is full' end
    return true
end
function Core.clamp(value, minimum, maximum)
    local n = Core.number(value)
    if not n then return minimum end
    return math.max(minimum, math.min(maximum, n))
end
function Core.selection(value)
    if type(value) == 'table' then value = value.Title or value[1] end
    return type(value) == 'string' and value or nil
end
function Core.lineNotice(value)
