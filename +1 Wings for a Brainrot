		runNowButton.MouseButton1Click:Connect(function()
			statusLabel.Text = "Claiming..."
			local ok, message = runAutoRewards()
			statusLabel.Text = message
			statusLabel.TextColor3 = ok and Color3.fromRGB(120, 220, 140) or Color3.fromRGB(230, 110, 110)
		end)

		local enabled = false
		local runToken = 0

		local function runAutoLoop()
			runToken += 1
			local myToken = runToken
			while enabled and myToken == runToken do
				local ok, message = runAutoRewards()
				statusLabel.Text = message
				statusLabel.TextColor3 = ok and Color3.fromRGB(120, 220, 140) or Color3.fromRGB(230, 110, 110)
				task.wait(10)
			end
		end

		toggleButton.MouseButton1Click:Connect(function()
			enabled = not enabled
			toggleButton.Text = "AUTO REWARDS: " .. (enabled and "ON" or "OFF")
			toggleButton.BackgroundColor3 = enabled and Color3.fromRGB(60, 180, 75) or Color3.fromRGB(180, 60, 60)
			if enabled then
				task.spawn(runAutoLoop)
			end
		end)
	end
end

