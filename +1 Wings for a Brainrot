	-- (built at runtime), so this searches whatever GOD_TIMER contains
	-- live. If this never finds anything, tell me the exact path to the
	-- countdown TextLabel in Studio and I'll point it there directly.
	local function findGodCountdownText()
		local godTimerModel = workspace:FindFirstChild("GOD_TIMER", true)
		if not godTimerModel then
			return nil
		end
		for _, descendant in ipairs(godTimerModel:GetDescendants()) do
			if descendant:IsA("TextLabel") and descendant.Text ~= "" then
