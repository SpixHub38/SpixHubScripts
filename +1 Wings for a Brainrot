-- Keyword used for the fuzzy fallback search in findAreaTarget, one per zone.
local AREA_ZONE_KEYWORDS = {
	Common = "common",
	Uncommon = "uncommon",
	Rare = "rare",
	Epic = "epic",
	Legendary = "legendary",
	Mythical = "mythical",
