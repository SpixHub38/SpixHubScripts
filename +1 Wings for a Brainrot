		for i = #ZONE_RARITY_ORDER, 1, -1 do
			local rarity = ZONE_RARITY_ORDER[i]
			local displayName = (rarity == "God") and "God Area" or rarity
			local pos = KNOWN_ZONE_POSITIONS[displayName]
			if pos then
				requestStreamAround(pos, 4096)
				local spawns = scanBrainrotSpawns(rarity)
				if #spawns > 0 then
					-- Already sorted highest-earnings-first by scanBrainrotSpawns.
					return displayName, spawns[1]
				end
			end
		end
		return nil, nil
	end

	local function farmTakeBrainrot(spawnData)
		if not spawnData.instance or not spawnData.instance.Parent then
			return false, "It despawned before we got there"
		end

		local ok, cframe = pcall(function()
			return spawnData.instance:GetPivot()
		end)
		if not ok then
			return false, "Couldn't read its position"
		end

		local character = player.Character or player.CharacterAdded:Wait()
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return false, "Character not ready"
		end

		requestStreamAround(cframe.Position, 512)
		hrp.CFrame = CFrame.new(cframe.Position)
		task.wait(0.4) -- let the touch/claim register

		return true
	end

