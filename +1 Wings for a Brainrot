			if best then
				statusLabel.Text = string.format(
					"%s — taking %s (Lvl %s, %s)",
					zoneName, tostring(best.name), tostring(best.level or "?"), best.earnings
				)
				statusLabel.TextColor3 = TEXT_PRIMARY
				local ok, err = farmTakeBrainrot(best)
				if not ok then
					statusLabel.Text = zoneName .. " — " .. tostring(err)
					statusLabel.TextColor3 = Color3.fromRGB(230, 110, 110)
				end
			else
				statusLabel.Text = "No zones have anything worth grabbing right now — waiting..."
				statusLabel.TextColor3 = TEXT_SECONDARY
			end
			task.wait(2)
		end
