-- "try the deepest zone first" search direction.
local ZONE_RARITY_ORDER = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical", "Secret", "Celestial", "Cosmic", "God" }

-- Folders/keywords that should never be treated as a zone floor, even if
-- their name happens to contain a rarity keyword (e.g. "CommonSound",
-- a "Promo" model with "Legendary" in its name, GUI text objects, etc).
local EXCLUDED_ANCESTOR_KEYWORDS = {
	"sound", "gui", "promo", "leaderboard", "decor", "killpart",
	"accessory", "ugcpromo", "collection_zone", "lava", "floater",
}

local function isUnderExcludedAncestor(inst)
	local node = inst
	while node and node ~= workspace do
		local lowerName = string.lower(node.Name)
		for _, bad in ipairs(EXCLUDED_ANCESTOR_KEYWORDS) do
			if string.find(lowerName, bad, 1, true) then
				return true
			end
		end
		node = node.Parent
	end
	return false
end

local function footprint(size)
	return size.X * size.Z
end

local function getFullPath(inst)
	local parts = {}
	local node = inst
	while node and node ~= workspace and node ~= game do
		table.insert(parts, 1, node.Name)
		node = node.Parent
	end
	return "Workspace." .. table.concat(parts, ".")
end

-- Returns position (Vector3), size (Vector3), and the matched instance
-- (for a debug path) for the best zone-floor candidate it can find. Tries:
--   1) Exact-name BasePart match — e.g. "CelestialPart" — scored by
--      horizontal footprint (X*Z), since a floor is wide & flat, not tall.
--   2) Exact-name Model match, using its bounding box.
--   3) Fuzzy: any BasePart whose name *equals or starts/ends with* the
--      zone keyword (e.g. "CelestialGround", "Zone_Celestial") — never a
--      loose "contains" match, and never anything under a GUI/Sound/
--      Promo/etc. container — scored the same way by footprint.
local function findAreaTarget(exactPartName, zoneKeyword)
	local keyword = string.lower(zoneKeyword)

	-- 1) exact BasePart, largest footprint wins
	local bestPart
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst.Name == exactPartName and inst:IsA("BasePart") then
			if not bestPart or footprint(inst.Size) > footprint(bestPart.Size) then
				bestPart = inst
			end
		end
	end
	if bestPart then
		return bestPart.Position, bestPart.Size, bestPart
	end

	-- 2) exact Model (bounding box)
	local bestModel
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst.Name == exactPartName and inst:IsA("Model") then
			local ok, cframe, size = pcall(function()
				return inst:GetBoundingBox()
			end)
			if ok and (not bestModel or footprint(size) > footprint(bestModel.size)) then
				bestModel = { cframe = cframe, size = size, inst = inst }
			end
		end
	end
	if bestModel then
		return bestModel.cframe.Position, bestModel.size, bestModel.inst
	end

	-- 3) fuzzy but strict: name must start or end with the keyword
	--    (not just "contain" it anywhere), and must not sit under an
	--    excluded container (Sounds/GUI/Promo/etc).
	local bestFuzzyPart
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("BasePart") then
			local lowerName = string.lower(inst.Name)
			local matches = (lowerName == keyword)
				or (string.sub(lowerName, 1, #keyword) == keyword)
				or (string.sub(lowerName, -#keyword) == keyword)
			if matches and not isUnderExcludedAncestor(inst) then
				if not bestFuzzyPart or footprint(inst.Size) > footprint(bestFuzzyPart.Size) then
					bestFuzzyPart = inst
				end
			end
		end
	end
	if bestFuzzyPart then
		return bestFuzzyPart.Position, bestFuzzyPart.Size, bestFuzzyPart
	end

	return nil, nil, nil
end

local function findGroundY(x, z, ignoreInstance)
	local rayOrigin = Vector3.new(x, 5000, z)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	if ignoreInstance then
		rayParams.FilterDescendantsInstances = { ignoreInstance }
	end
	local result = workspace:Raycast(rayOrigin, Vector3.new(0, -10000, 0), rayParams)
	if result then
		return result.Position.Y
	end
	return nil
end

-- Once a zone's floor is found, its world position doesn't change — so we
-- cache it. That way if the part later streams back out (you moved away),
-- teleporting there again still works instantly without needing to re-find it.
local zonePositionCache = {}

local function teleportToArea(areaName)
	-- Fastest, most reliable path: a known/hardcoded coordinate needs no
	-- searching or streaming at all — Roblox streams the destination in
	-- around you after the CFrame is set, exactly like the game's own
	-- teleporters do.
	local known = KNOWN_ZONE_POSITIONS[areaName]
	if known then
		local character = player.Character or player.CharacterAdded:Wait()
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return false, "Character not ready"
		end

		pcall(function()
			workspace:RequestStreamAroundAsync(known, 2048)
		end)

		local groundY = findGroundY(known.X, known.Z, character)
		local targetY = groundY and (groundY + 4) or (known.Y + 8)
		hrp.CFrame = CFrame.new(known.X, targetY, known.Z)
		return true, areaName .. " area [known location]"
	end

	local partName = AREA_PART_NAMES[areaName]
	local zoneKeyword = AREA_ZONE_KEYWORDS[areaName] or string.lower(areaName)

	local position, size, matchedInst = findAreaTarget(partName, zoneKeyword)

	-- Not found on the first pass — most likely it just hasn't streamed in
	-- yet. Ask the client to stream in a large area around the player, wait
	-- briefly, then try again once before giving up.
	if not position then
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if hrp then
			pcall(function()
				workspace:RequestStreamAroundAsync(hrp.Position, 4096)
			end)
		end
		task.wait(0.5)
		position, size, matchedInst = findAreaTarget(partName, zoneKeyword)
	end

	-- Still not found — fall back to the last known position for this zone,
	-- if we've successfully teleported there before this session (either
	-- found automatically, or captured with the "Save Current Spot" button).
	if not position and zonePositionCache[areaName] then
		local cached = zonePositionCache[areaName]
		position, size, matchedInst = cached.position, cached.size, nil
	end

	if not position then
		return false, areaName .. " area not found. Walk there once and press \"Save Current Spot\" to fix this permanently."
	end

	zonePositionCache[areaName] = { position = position, size = size }

	local character = player.Character or player.CharacterAdded:Wait()
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return false, "Character not ready"
	end

	local groundY = findGroundY(position.X, position.Z, character)
	local sizeY = (size and size.Y) or 4
	local targetY = groundY and (groundY + 4) or (position.Y + (sizeY / 2) + 5)

	hrp.CFrame = CFrame.new(position.X, targetY, position.Z)

	local pathNote = matchedInst and (" [" .. getFullPath(matchedInst) .. "]") or " [cached location]"
	return true, areaName .. " area" .. pathNote
end

-- ===== Wild brainrot spawn detection (shared by Auto Farm / God Watch) =====

-- Converts a shorthand earnings/price string like "+635K/s", "1.2M", or
-- "12.4B" into a plain comparable number, so Auto Farm can pick the
-- highest-earning brainrot instead of just comparing text alphabetically.
local SHORTHAND_SCALE = {
	K = 1e3, M = 1e6, B = 1e9, T = 1e12,
	Qa = 1e15, Qi = 1e18, Sx = 1e21, Sp = 1e24, Oc = 1e27, No = 1e30,
}
local function parseShorthandNumber(text)
	if not text then
		return 0
	end
	local numPart, suffix = string.match(text, "([%d%.]+)%s*([A-Za-z]*)")
	if not numPart then
		return 0
	end
	local value = tonumber(numPart) or 0
	if suffix and suffix ~= "" then
		-- Try the two-letter suffix first (Qa, Qi, ...), then one-letter.
		local scale = SHORTHAND_SCALE[suffix] or SHORTHAND_SCALE[string.sub(suffix, 1, 1)]
		if scale then
			value = value * scale
		end
	end
	return value
end

-- Shared streaming helper: forces the client to load content around a
-- given world position before we try to find or interact with anything
-- there — same fix as the zone-teleporter, reused everywhere we might
-- otherwise be looking at unstreamed (nonexistent-to-the-client) parts.
local function requestStreamAround(pos, radius)
	pcall(function()
		workspace:RequestStreamAroundAsync(pos, radius or 4096)
	end)
end

-- Every spawned brainrot is a Model named "VisualItem" with attributes
-- Rarity / Level / OriginalName, and (as descendants) an "InfoGUI"
-- billboard with a "Earnings" TextLabel and an "ExpiresGUI" billboard
-- with a "Timer" TextLabel showing the despawn countdown.
--
-- IMPORTANT: "VisualItem" is NOT unique to wild zone spawns — your OWN
-- collected/placed brainrots on your base use the exact same model name
-- and attributes (Workspace.Plots.Plot_<you>.Floor#.Slots.Slot#.Spawn.
-- VisualItem). Those are always excluded here.
local function isOwnPlotItem(inst)
	local node = inst
	while node and node ~= workspace do
		if node.Name == "Plots" then
			return true
		end
		node = node.Parent
	end
	return false
end

-- Returns every WILD (non-plot) brainrot currently spawned with the given
-- rarity, sorted highest-earnings-first. zoneRarity is required — e.g.
-- "Uncommon" or "God" (use zoneDisplayNameToRarity to convert a
-- AREA_ORDER display name like "God Area" first).
local function scanBrainrotSpawns(zoneRarity)
	local results = {}

	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst.Name == "VisualItem" and inst:IsA("Model") and not isOwnPlotItem(inst) then
			local rarity = inst:GetAttribute("Rarity")
			if rarity and rarity == zoneRarity then
				local name = inst:GetAttribute("OriginalName") or inst.Name
				local level = inst:GetAttribute("Level")

				local earningsText, despawnText
				for _, descendant in ipairs(inst:GetDescendants()) do
					if descendant:IsA("TextLabel") then
						if descendant.Name == "Earnings" and not earningsText then
							earningsText = descendant.Text
						elseif descendant.Name == "Timer" and not despawnText then
							despawnText = descendant.Text
						end
					end
					if earningsText and despawnText then
						break
					end
				end

				table.insert(results, {
					instance = inst,
					name = name,
					level = level,
					rarity = rarity,
					earnings = earningsText or "?",
					earningsValue = parseShorthandNumber(earningsText),
					despawn = despawnText or "?",
				})
			end
		end
	end

	table.sort(results, function(a, b)
		return a.earningsValue > b.earningsValue
	end)

	return results
end

