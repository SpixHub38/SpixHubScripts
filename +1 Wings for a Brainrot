		if plot then
			return plot
		end
		-- Fallback: some games suffix/prefix differently — look for any
		-- plot whose name contains the player's name.
		local lowerPlayerName = string.lower(player.Name)
		for _, child in ipairs(plotsFolder:GetChildren()) do
